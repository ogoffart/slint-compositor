import { Theme } from "theme.slint";
import { Button } from "std-widgets.slint";

// Settings dialog: colour scheme, accent, panel placement/size, background.
export component Settings inherits Rectangle {
    in-out property <int> panel-edge;     // 0=Right 1=Left 2=Top 3=Bottom
    in-out property <length> panel-size;
    callback change-background();
    callback changed();                   // any setting changed (triggers a save)
    callback close();

    property <[color]> accents: [#89b4fa, #a6e3a1, #f38ba8, #f9e2af, #cba6f7, #94e2d5];

    background: Theme.overlay;

    TouchArea {
        clicked => {
            root.close();
        }
    }

    Rectangle {
        width: 460px;
        height: 420px;
        background: Theme.bg;
        border-radius: 10px;
        border-width: 1px;
        border-color: Theme.hover;

        TouchArea {}

        VerticalLayout {
            padding: 18px;
            spacing: 14px;

            Text {
                text: "Settings";
                color: Theme.fg;
                font-size: 18px;
                font-weight: 700;
            }

            // Colour scheme.
            HorizontalLayout {
                spacing: 8px;
                Text {
                    text: "Colour scheme";
                    color: Theme.fg;
                    vertical-alignment: center;
                    width: 110px;
                }
                for label[i] in ["Dark", "Light"]: Rectangle {
                    height: 30px;
                    border-radius: 6px;
                    background: (Theme.dark == (i == 0)) ? Theme.accent : Theme.surface;
                    Text {
                        text: label;
                        color: Theme.fg;
                        font-size: 12px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    TouchArea {
                        clicked => {
                            Theme.dark = (i == 0);
                            root.changed();
                        }
                    }
                }
            }

            // Accent colour.
            HorizontalLayout {
                spacing: 8px;
                Text {
                    text: "Accent";
                    color: Theme.fg;
                    vertical-alignment: center;
                    width: 110px;
                }
                for swatch in root.accents: Rectangle {
                    height: 30px;
                    border-radius: 6px;
                    background: swatch;
                    border-width: Theme.accent == swatch ? 2px : 0px;
                    border-color: Theme.fg;
                    TouchArea {
                        clicked => {
                            Theme.accent = swatch;
                            root.changed();
                        }
                    }
                }
            }

            // Panel edge.
            HorizontalLayout {
                spacing: 8px;
                Text {
                    text: "Panel edge";
                    color: Theme.fg;
                    vertical-alignment: center;
                    width: 110px;
                }
                for label[i] in ["Right", "Left", "Top", "Bottom"]: Rectangle {
                    height: 30px;
                    border-radius: 6px;
                    background: root.panel-edge == i ? Theme.accent : Theme.surface;
                    Text {
                        text: label;
                        color: Theme.fg;
                        font-size: 12px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    TouchArea {
                        clicked => {
                            root.panel-edge = i;
                            root.changed();
                        }
                    }
                }
            }

            // Panel size.
            HorizontalLayout {
                spacing: 8px;
                Text {
                    text: "Panel size";
                    color: Theme.fg;
                    vertical-alignment: center;
                    width: 110px;
                }
                Button {
                    text: "−";
                    clicked => {
                        root.panel-size = max(40px, root.panel-size - 8px);
                        root.changed();
                    }
                }
                Text {
                    text: round(root.panel-size / 1px) + " px";
                    color: Theme.fg;
                    vertical-alignment: center;
                    horizontal-alignment: center;
                    width: 70px;
                }
                Button {
                    text: "+";
                    clicked => {
                        root.panel-size = min(240px, root.panel-size + 8px);
                        root.changed();
                    }
                }
            }

            // Background.
            HorizontalLayout {
                spacing: 10px;
                Text {
                    text: "Background image";
                    color: Theme.fg;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
                Button {
                    text: "Change…";
                    clicked => {
                        root.change-background();
                    }
                }
            }

            Rectangle { vertical-stretch: 1; }

            HorizontalLayout {
                alignment: end;
                Button {
                    text: "Close";
                    clicked => {
                        root.close();
                    }
                }
            }
        }
    }
}
