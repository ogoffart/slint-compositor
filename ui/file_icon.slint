import { Theme } from "theme.slint";

// A small type-coloured icon: a folder for directories, otherwise a document
// glyph tinted by file kind. Drawn (rather than emoji) so it renders crisply
// regardless of the available fonts. Shared by the file dialog and the
// standalone Files browser.
export component FileIcon inherits Rectangle {
    in property <string> kind;
    in property <bool> is-dir;
    width: 22px;
    height: 22px;

    // Per-kind accent colour.
    property <color> tint:
        is-dir ? #e6b34d :
        kind == "image" ? #5cc46a :
        kind == "audio" ? #b07cd8 :
        kind == "video" ? #e0685f :
        kind == "archive" ? #c9925a :
        kind == "code" ? #5a9be0 :
        kind == "pdf" ? #e0685f :
        kind == "exec" ? #4bb6a8 :
        #9aa3b0;

    // Short label shown on document icons.
    property <string> badge:
        kind == "image" ? "▦" :
        kind == "audio" ? "♪" :
        kind == "video" ? "▶" :
        kind == "archive" ? "▤" :
        kind == "code" ? "<>" :
        kind == "pdf" ? "P" :
        kind == "exec" ? "$" :
        "";

    if is-dir: Rectangle {
        // Folder: a body with a small tab on the top-left.
        Rectangle {
            y: 3px;
            width: 9px;
            height: 5px;
            x: 2px;
            background: root.tint.darker(0.15);
            border-radius: 1px;
        }
        Rectangle {
            y: 6px;
            width: 18px;
            height: 12px;
            x: 2px;
            background: root.tint;
            border-radius: 2px;
        }
    }
    if !is-dir: Rectangle {
        // Document: a rounded page with a coloured spine and a kind badge.
        width: 16px;
        height: 19px;
        background: Theme.surface.brighter(0.4);
        border-radius: 2px;
        border-width: 1px;
        border-color: root.tint;
        Rectangle {
            x: 0;
            width: 3px;
            height: parent.height;
            background: root.tint;
            border-top-left-radius: 2px;
            border-bottom-left-radius: 2px;
        }
        Text {
            text: root.badge;
            color: root.tint;
            font-size: 9px;
            horizontal-alignment: center;
            vertical-alignment: center;
            x: 3px;
            width: parent.width - 3px;
        }
    }
}
