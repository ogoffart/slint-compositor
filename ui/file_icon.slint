import { Theme } from "theme.slint";

// A type-coloured icon: a folder for directories, otherwise a document glyph
// tinted by file kind, with a short badge. Drawn (rather than emoji) so it
// renders crisply at any size — every dimension is a fraction of the icon's
// box, so the same component serves the 22px list rows and the 64px icon grid.
// Shared by the file dialog and the standalone Files browser.
export component FileIcon inherits Rectangle {
    in property <string> kind;
    in property <bool> is-dir;
    width: 22px;
    height: 22px;

    // Per-kind accent colour.
    property <color> tint:
        is-dir ? #e6b34d :
        kind == "image" ? #5cc46a :
        kind == "audio" ? #b07cd8 :
        kind == "video" ? #e0685f :
        kind == "archive" ? #c9925a :
        kind == "code" ? #5a9be0 :
        kind == "pdf" ? #e0685f :
        kind == "exec" ? #4bb6a8 :
        #9aa3b0;

    // Short label shown on document icons.
    property <string> badge:
        kind == "image" ? "▦" :
        kind == "audio" ? "♪" :
        kind == "video" ? "▶" :
        kind == "archive" ? "▤" :
        kind == "code" ? "<>" :
        kind == "pdf" ? "P" :
        kind == "exec" ? "$" :
        "";

    property <length> u: min(root.width, root.height);

    if is-dir: Rectangle {
        // Folder: a body with a small tab on the top-left.
        Rectangle {
            x: root.u * 0.09;
            y: root.u * 0.14;
            width: root.u * 0.41;
            height: root.u * 0.23;
            background: root.tint.darker(0.15);
            border-radius: root.u * 0.05;
        }
        Rectangle {
            x: root.u * 0.09;
            y: root.u * 0.27;
            width: root.u * 0.82;
            height: root.u * 0.55;
            background: root.tint;
            border-radius: root.u * 0.09;
        }
    }
    if !is-dir: Rectangle {
        // Document: a rounded page with a coloured spine and a kind badge.
        width: root.u * 0.66;
        height: root.u * 0.84;
        background: Theme.surface.brighter(0.4);
        border-radius: root.u * 0.09;
        border-width: max(1px, root.u * 0.045);
        border-color: root.tint;
        Rectangle {
            x: 0;
            width: root.u * 0.14;
            height: parent.height;
            background: root.tint;
            border-top-left-radius: parent.border-radius;
            border-bottom-left-radius: parent.border-radius;
        }
        Text {
            text: root.badge;
            color: root.tint;
            font-size: root.u * 0.4;
            font-weight: 700;
            horizontal-alignment: center;
            vertical-alignment: center;
            x: root.u * 0.14;
            width: parent.width - root.u * 0.14;
        }
    }
}
