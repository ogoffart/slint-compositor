import { Theme } from "theme.slint";
import { Button, ScrollView, LineEdit } from "std-widgets.slint";
import { FileItem } from "types.slint";

// A reusable file-open dialog. It is driven entirely from Rust (which fills
// `path`/`items` and handles navigation), so the same dialog backs both the
// in-shell settings flow and the XDG desktop portal.
export component FileDialog inherits Rectangle {
    in property <string> title: "Open File";
    in property <string> path;
    in property <[FileItem]> items;
    in-out property <int> selected: -1;

    callback entry-clicked(int);
    callback go-up();
    callback accept();
    callback cancel();
    callback navigate-to(string);     // a path typed into the editable bar
    callback move-selection(int);     // keyboard arrow delta (+1/-1)
    callback activate-selected();     // Enter: open file or enter directory

    background: Theme.overlay;

    // Focus the keyboard handler as soon as the dialog appears.
    init => {
        keys.focus();
    }

    // Click outside the panel to cancel.
    TouchArea {
        clicked => {
            root.cancel();
        }
    }

    Rectangle {
        width: 640px;
        height: 480px;
        background: Theme.bg;
        border-radius: 10px;
        border-width: 1px;
        border-color: Theme.hover;

        TouchArea {} // swallow clicks on the panel

        VerticalLayout {
            padding: 14px;
            spacing: 10px;

            Text {
                text: root.title;
                color: Theme.fg;
                font-size: 16px;
            }

            HorizontalLayout {
                spacing: 8px;
                Button {
                    text: "⬆ Up";
                    clicked => {
                        root.go-up();
                    }
                }
                // Editable current-directory path: type a folder and press Enter.
                LineEdit {
                    text: root.path;
                    horizontal-stretch: 1;
                    accepted(text) => {
                        root.navigate-to(text);
                    }
                }
            }

            keys := FocusScope {
                key-pressed(e) => {
                    if (e.text == Key.UpArrow) {
                        root.move-selection(-1);
                        return EventResult.accept;
                    }
                    if (e.text == Key.DownArrow) {
                        root.move-selection(1);
                        return EventResult.accept;
                    }
                    if (e.text == Key.Return) {
                        root.activate-selected();
                        return EventResult.accept;
                    }
                    if (e.text == Key.Backspace) {
                        root.go-up();
                        return EventResult.accept;
                    }
                    if (e.text == Key.Escape) {
                        root.cancel();
                        return EventResult.accept;
                    }
                    return EventResult.reject;
                }

                ScrollView {
                    VerticalLayout {
                        alignment: start;
                        for item[idx] in root.items: Rectangle {
                            height: 28px;
                            background: idx == root.selected ? Theme.accent
                                : (entry-area.has-hover ? Theme.surface : transparent);
                            HorizontalLayout {
                                padding-left: 8px;
                                Text {
                                    text: item.is-dir ? item.name + "/" : item.name;
                                    color: item.is-dir ? Theme.accent : Theme.fg;
                                    font-size: 13px;
                                    vertical-alignment: center;
                                    overflow: elide;
                                    horizontal-stretch: 1;
                                }
                            }
                            entry-area := TouchArea {
                                clicked => {
                                    root.entry-clicked(idx);
                                }
                            }
                        }
                    }
                }
            }

            HorizontalLayout {
                alignment: end;
                spacing: 8px;
                Button {
                    text: "Cancel";
                    clicked => {
                        root.cancel();
                    }
                }
                Button {
                    text: "Open";
                    enabled: root.selected >= 0;
                    clicked => {
                        root.accept();
                    }
                }
            }
        }
    }
}
