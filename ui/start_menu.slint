import { Theme } from "theme.slint";
import { LineEdit } from "std-widgets.slint";
import { MenuEntry } from "types.slint";

// A row in the start menu.
component MenuRow inherits Rectangle {
    in property <string> icon;
    in property <string> label;
    in property <color> icon-color: Theme.fg;
    callback clicked();
    height: 36px;
    border-radius: 8px;
    background: ta.has-hover ? Theme.surface : transparent;
    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 10px;
        Text {
            text: root.icon;
            color: root.icon-color;
            font-size: 17px;
            width: 22px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        Text {
            text: root.label;
            color: Theme.fg;
            font-size: 14px;
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
        }
    }
    ta := TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

// A Windows-style start menu: a list of configurable apps plus power actions
// (run a command, lock the screen, log out). Shown as a dimming overlay; the
// menu panel is anchored next to the Start button (i.e. against the panel, at
// its near end). Click the backdrop or press Escape to dismiss.
export component StartMenu inherits Rectangle {
    in property <[MenuEntry]> entries;
    // Where the panel (and its Start button) is, so the menu opens beside it.
    in property <int> panel-edge;        // 0=Right 1=Left 2=Top 3=Bottom
    in property <length> panel-size;
    in property <length> anchor-x;       // primary output rect (the menu's screen)
    in property <length> anchor-y;
    in property <length> anchor-w;
    in property <length> anchor-h;
    callback query-changed(string);
    callback launch(string);
    callback run();
    callback lock();
    callback suspend();
    callback reboot();
    callback shutdown();
    callback logout();
    callback dismiss();

    background: Theme.overlay;

    TouchArea {
        clicked => {
            root.dismiss();
        }
    }

    Rectangle {
        // Sit against the panel, aligned to its near end (top for a vertical
        // panel, left for a horizontal one) so it appears by the Start button.
        x: root.panel-edge == 0 ? root.anchor-x + root.anchor-w - root.panel-size - self.width - 12px
            : root.panel-edge == 1 ? root.anchor-x + root.panel-size + 12px
            : root.anchor-x + 12px;
        y: root.panel-edge == 2 ? root.anchor-y + root.panel-size + 12px
            : root.panel-edge == 3 ? root.anchor-y + root.anchor-h - self.height - 12px
            : root.anchor-y + 12px;
        width: 290px;
        height: menu.preferred-height;
        background: Theme.bg;
        border-radius: 12px;
        border-width: 1px;
        border-color: Theme.hover;

        // Swallow clicks so they don't reach the dismiss backdrop.
        TouchArea {}

        init => {
            search.focus();
            root.query-changed("");
        }

        menu := VerticalLayout {
            padding: 12px;
            spacing: 2px;

            search := LineEdit {
                font-size: 14px;
                placeholder-text: "Search apps…";
                edited(text) => {
                    root.query-changed(text);
                }
                accepted(text) => {
                    if root.entries.length > 0 {
                        root.launch(root.entries[0].command);
                    } else if text != "" {
                        root.launch(text);
                    }
                }
            }

            Text {
                text: "Applications";
                color: Theme.subtext;
                font-size: 11px;
                font-weight: 700;
            }

            for e in root.entries: MenuRow {
                icon: e.icon;
                label: e.name;
                clicked => {
                    root.launch(e.command);
                }
            }

            Rectangle {
                height: 9px;
                Rectangle {
                    y: 4px;
                    height: 1px;
                    background: Theme.hover;
                }
            }

            MenuRow {
                icon: "⌨";
                label: "Run a command…";
                clicked => {
                    root.run();
                }
            }
            MenuRow {
                icon: "🔒";
                label: "Lock screen";
                clicked => {
                    root.lock();
                }
            }
            MenuRow {
                icon: "☾";
                label: "Suspend";
                clicked => {
                    root.suspend();
                }
            }
            MenuRow {
                icon: "↻";
                label: "Restart";
                clicked => {
                    root.reboot();
                }
            }
            MenuRow {
                icon: "⏻";
                label: "Shut down";
                icon-color: #f38ba8;
                clicked => {
                    root.shutdown();
                }
            }
            MenuRow {
                icon: "⇲";
                label: "Log out";
                clicked => {
                    root.logout();
                }
            }
        }
    }

    forward-focus: fs;
    fs := FocusScope {
        key-pressed(event) => {
            if event.text == Key.Escape {
                root.dismiss();
                return accept;
            }
            return reject;
        }
    }
}
