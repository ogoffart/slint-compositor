import { Theme } from "theme.slint";
import { Clock } from "clock.slint";
import { Eyes } from "eyes.slint";
import { WindowTile, TrayIcon, MenuEntry } from "types.slint";

// One StatusNotifierItem icon in the tray.
component TrayButton inherits Rectangle {
    in property <TrayIcon> item;
    callback activate();
    width: 28px;
    height: 28px;
    border-radius: 6px;
    background: ta.has-hover ? Theme.surface : transparent;
    Image {
        source: root.item.icon;
        width: 20px;
        height: 20px;
        image-fit: contain;
    }
    ta := TouchArea {
        clicked => {
            root.activate();
        }
    }
}

// The system-tray (SNI) icon strip.
component TrayStrip {
    in property <[TrayIcon]> items;
    in property <bool> horizontal;
    callback activate(string);
    if root.horizontal: HorizontalLayout {
        spacing: 2px;
        for it in root.items: TrayButton {
            item: it;
            activate => {
                root.activate(it.id);
            }
        }
    }
    if !root.horizontal: VerticalLayout {
        spacing: 2px;
        for it in root.items: TrayButton {
            item: it;
            activate => {
                root.activate(it.id);
            }
        }
    }
}

// A single icon button in the panel, with a hover tooltip.
component PanelButton inherits Rectangle {
    in property <string> icon;
    in property <color> icon-color: Theme.fg;
    in property <string> tooltip;
    in property <int> edge;   // 0=Right 1=Left 2=Top 3=Bottom
    callback clicked();
    callback scrolled(float);   // wheel delta-y over the button
    border-radius: 8px;
    background: ta.has-hover ? Theme.surface : Theme.panel;
    Text {
        text: root.icon;
        color: root.icon-color;
        font-size: 18px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    ta := TouchArea {
        clicked => {
            root.clicked();
        }
        scroll-event(e) => {
            root.scrolled(e.delta-y / 1px);
            accept
        }
    }

    // Tooltip bubble, placed toward the screen interior from the panel edge.
    if ta.has-hover && root.tooltip != "": Rectangle {
        width: tip.preferred-width + 16px;
        height: tip.preferred-height + 10px;
        background: Theme.bg;
        border-radius: 6px;
        border-width: 1px;
        border-color: Theme.hover;
        x: root.edge == 0 ? -self.width - 8px
            : root.edge == 1 ? root.width + 8px
            : (root.width - self.width) / 2;
        y: root.edge == 2 ? root.height + 8px
            : root.edge == 3 ? -self.height - 8px
            : (root.height - self.height) / 2;
        tip := Text {
            text: root.tooltip;
            color: Theme.fg;
            font-size: 12px;
            x: 8px;
            y: 5px;
        }
    }
}

// Battery charge indicator: a drawn cell whose fill and colour track the level,
// with a charging bolt and the percentage. Lays out along the panel's long axis.
component BatteryApplet {
    in property <float> percent;   // 0..100
    in property <bool> charging;
    in property <bool> horizontal;
    property <color> level: root.percent <= 15 ? #f38ba8
        : root.percent <= 30 ? #f9e2af : #a6e3a1;

    // The battery glyph: outline, proportional fill, terminal nub and bolt.
    cell := Rectangle {
        width: 30px;
        height: 15px;
        Rectangle {
            width: 26px;
            height: 15px;
            x: 0;
            border-radius: 3px;
            border-width: 1.5px;
            border-color: Theme.subtext;
            Rectangle {
                x: 2px;
                y: 2.5px;
                width: (parent.width - 4px) * max(0.04, min(1, root.percent / 100));
                height: parent.height - 5px;
                border-radius: 1px;
                background: root.level;
            }
        }
        Rectangle {
            x: 26px;
            y: 5px;
            width: 2.5px;
            height: 5px;
            border-radius: 1px;
            background: Theme.subtext;
        }
        if root.charging: Text {
            x: 0;
            width: 26px;
            text: "⚡";
            color: Theme.fg;
            font-size: 10px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    pct := Text {
        text: round(root.percent) + "%";
        color: Theme.subtext;
        font-size: 10px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    // Side by side on a horizontal panel; stacked on a vertical one.
    states [
        h when root.horizontal: {
            cell.x: 0;
            cell.y: (root.height - cell.height) / 2;
            pct.x: cell.width + 4px;
            pct.y: (root.height - pct.height) / 2;
            root.preferred-width: cell.width + pct.preferred-width + 4px;
            root.preferred-height: 15px;
        }
        v when !root.horizontal: {
            cell.x: (root.width - cell.width) / 2;
            cell.y: 0;
            pct.x: (root.width - pct.width) / 2;
            pct.y: cell.height + 1px;
            root.preferred-width: 30px;
            root.preferred-height: cell.height + pct.preferred-height + 1px;
        }
    ]
}

// One labelled load bar (CPU or memory): a track with a fill scaled by `value`.
component LoadBar inherits Rectangle {
    in property <string> label;
    in property <float> value;   // 0..1
    in property <color> fill: Theme.accent;
    width: 12px;
    VerticalLayout {
        spacing: 1px;
        Rectangle {
            vertical-stretch: 1;
            width: 10px;
            border-radius: 2px;
            background: Theme.surface;
            Rectangle {
                width: parent.width;
                height: parent.height * min(1, max(0, root.value));
                y: parent.height - self.height;
                border-radius: 2px;
                background: root.fill;
            }
        }
        Text {
            text: root.label;
            color: Theme.subtext;
            font-size: 8px;
            horizontal-alignment: center;
        }
    }
}

// CPU + memory mini-monitor.
component LoadMonitor inherits Rectangle {
    in property <float> cpu;
    in property <float> mem;
    HorizontalLayout {
        spacing: 3px;
        alignment: center;
        LoadBar { label: "C"; value: root.cpu; fill: #89b4fa; height: 30px; }
        LoadBar { label: "M"; value: root.mem; fill: #a6e3a1; height: 30px; }
    }
}

// Keyboard layout indicator/switcher: shows the active layout code; click cycles.
component LayoutSwitcher inherits Rectangle {
    in property <string> layout;
    callback clicked();
    width: 34px;
    height: 26px;
    border-radius: 6px;
    background: ta.has-hover ? Theme.surface : Theme.panel;
    border-width: 1px;
    border-color: Theme.hover;
    Text {
        text: root.layout == "" ? "?" : root.layout;
        color: Theme.fg;
        font-size: 12px;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    ta := TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

// A taskbar entry for one window: its icon and title.
component TaskItem inherits Rectangle {
    in property <WindowTile> tile;
    callback activate();
    border-radius: 6px;
    background: tile.focused ? Theme.accent : (a.has-hover ? Theme.surface : Theme.panel);
    HorizontalLayout {
        padding-left: 6px;
        padding-right: 6px;
        spacing: 5px;
        alignment: center;
        Image {
            source: tile.icon;
            width: 18px;
            height: 18px;
            image-fit: contain;
        }
        Text {
            text: tile.title == "" ? "?" : tile.title;
            color: Theme.fg;
            font-size: 11px;
            horizontal-alignment: center;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }
    }
    a := TouchArea {
        clicked => {
            root.activate();
        }
    }
}

// Virtual-desktop switcher. The desktops flow across the panel's thickness:
// a single line when the panel is thin, wrapping into a compact grid once the
// panel is wide enough to fit more than one lane.
component WorkspaceSwitcher {
    in property <int> active;
    in property <int> count: 4;
    in property <bool> horizontal;
    in property <length> thickness;   // panel cross-axis size
    callback switch(int);

    // Cells across the thickness: 1 (thin) up to 3 (very wide).
    property <int> lanes: root.thickness >= 128px ? 3 : root.thickness >= 60px ? 2 : 1;

    GridLayout {
        spacing: 3px;
        for i in root.count: Rectangle {
            row: root.horizontal ? Math.mod(i, root.lanes) : floor(i / root.lanes);
            col: root.horizontal ? floor(i / root.lanes) : Math.mod(i, root.lanes);
            min-width: 22px;
            min-height: 22px;
            border-radius: 5px;
            background: i == root.active ? Theme.accent : Theme.surface;
            Text {
                text: "\{i + 1}";
                color: Theme.fg;
                font-size: 11px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            TouchArea {
                clicked => { root.switch(i); }
                scroll-event(e) => {
                    if e.delta-y < 0 && root.active < root.count - 1 {
                        root.switch(root.active + 1);
                    } else if e.delta-y >= 0 && root.active > 0 {
                        root.switch(root.active - 1);
                    }
                    accept
                }
            }
        }
    }
}

// The shell panel. Lays its content out along its long axis: vertically when
// docked left/right, horizontally when docked top/bottom.
export component Panel inherits Rectangle {
    in property <bool> horizontal;
    in property <int> edge;   // 0=Right 1=Left 2=Top 3=Bottom (for tooltip placement)
    in property <[WindowTile]> windows;
    in property <string> clock-hours;
    in property <string> clock-minutes;
    in property <length> cursor-x;
    in property <length> cursor-y;
    in property <int> active-workspace;
    in property <int> workspace-count: 4;
    in property <length> thickness;   // panel size along its short axis
    in property <[TrayIcon]> tray-icons;
    in property <[MenuEntry]> launchers;
    in property <bool> muted;
    in property <bool> dnd;
    in property <bool> battery-present;
    in property <float> battery-percent;
    in property <bool> battery-charging;
    in property <float> cpu-load;
    in property <float> mem-load;
    in property <string> keyboard-layout;
    in property <bool> keyboard-layout-visible;
    callback cycle-keyboard-layout();
    callback show-desktop();
    callback toggle-start-menu();
    callback toggle-settings();
    callback toggle-quick-settings();
    callback toggle-notification-center();
    callback toggle-calendar();
    callback launch(string);
    callback activate(int);
    callback switch-workspace(int);
    callback tray-activate(string);
    callback volume-scroll(float);

    background: Theme.panel;

    if !root.horizontal: VerticalLayout {
        padding: 8px;
        spacing: 10px;
        PanelButton {
            icon: "⊞";
            icon-color: Theme.accent;
            height: 40px;
            tooltip: "Start menu";
            edge: root.edge;
            clicked => { root.toggle-start-menu(); }
        }
        for app in root.launchers: PanelButton {
            icon: app.icon;
            icon-color: #e6b34d;
            height: 40px;
            tooltip: app.name;
            edge: root.edge;
            clicked => { root.launch(app.command); }
        }
        PanelButton {
            icon: "⚙";
            icon-color: #f9e2af;
            height: 40px;
            tooltip: "Settings";
            edge: root.edge;
            clicked => { root.toggle-settings(); }
        }
        PanelButton {
            icon: root.muted ? "🔇" : "🔊";
            icon-color: Theme.fg;
            height: 40px;
            tooltip: "Sound & network";
            edge: root.edge;
            clicked => { root.toggle-quick-settings(); }
            scrolled(dy) => { root.volume-scroll(dy); }
        }
        PanelButton {
            icon: root.dnd ? "🔕" : "🔔";
            icon-color: Theme.fg;
            height: 40px;
            tooltip: "Notifications";
            edge: root.edge;
            clicked => { root.toggle-notification-center(); }
        }
        Clock { hours: root.clock-hours; minutes: root.clock-minutes; clicked => { root.toggle-calendar(); } }
        Eyes { cursor-x: root.cursor-x; cursor-y: root.cursor-y; }
        Rectangle { height: 1px; background: Theme.surface; }
        HorizontalLayout {
            alignment: center;
            spacing: 6px;
            LoadMonitor { cpu: root.cpu-load; mem: root.mem-load; }
            if root.keyboard-layout-visible: LayoutSwitcher {
                layout: root.keyboard-layout;
                clicked => { root.cycle-keyboard-layout(); }
            }
        }
        if root.battery-present: BatteryApplet {
            percent: root.battery-percent;
            charging: root.battery-charging;
            horizontal: false;
        }
        if root.tray-icons.length > 0: Rectangle { height: 1px; background: Theme.surface; }
        TrayStrip {
            items: root.tray-icons;
            horizontal: false;
            activate(id) => { root.tray-activate(id); }
        }
        Rectangle { height: 1px; background: Theme.surface; }
        WorkspaceSwitcher {
            active: root.active-workspace;
            count: root.workspace-count;
            thickness: root.thickness;
            horizontal: false;
            switch(n) => { root.switch-workspace(n); }
        }
        Rectangle { height: 1px; background: Theme.surface; }
        VerticalLayout {
            vertical-stretch: 1;
            spacing: 6px;
            alignment: start;
            for win in root.windows: TaskItem {
                tile: win;
                height: 40px;
                activate => { root.activate(win.id); }
            }
        }
        PanelButton {
            icon: "🖥";
            height: 36px;
            tooltip: "Show desktop";
            edge: root.edge;
            clicked => { root.show-desktop(); }
        }
    }

    if root.horizontal: HorizontalLayout {
        padding: 8px;
        spacing: 10px;
        PanelButton {
            icon: "⊞";
            icon-color: Theme.accent;
            width: 40px;
            tooltip: "Start menu";
            edge: root.edge;
            clicked => { root.toggle-start-menu(); }
        }
        for app in root.launchers: PanelButton {
            icon: app.icon;
            icon-color: #e6b34d;
            width: 40px;
            tooltip: app.name;
            edge: root.edge;
            clicked => { root.launch(app.command); }
        }
        PanelButton {
            icon: "⚙";
            icon-color: #f9e2af;
            width: 40px;
            tooltip: "Settings";
            edge: root.edge;
            clicked => { root.toggle-settings(); }
        }
        PanelButton {
            icon: root.muted ? "🔇" : "🔊";
            icon-color: Theme.fg;
            width: 40px;
            tooltip: "Sound & network";
            edge: root.edge;
            clicked => { root.toggle-quick-settings(); }
            scrolled(dy) => { root.volume-scroll(dy); }
        }
        PanelButton {
            icon: root.dnd ? "🔕" : "🔔";
            icon-color: Theme.fg;
            width: 40px;
            tooltip: "Notifications";
            edge: root.edge;
            clicked => { root.toggle-notification-center(); }
        }
        Clock { hours: root.clock-hours; minutes: root.clock-minutes; clicked => { root.toggle-calendar(); } }
        Eyes { cursor-x: root.cursor-x; cursor-y: root.cursor-y; }
        Rectangle { width: 1px; background: Theme.surface; }
        LoadMonitor { cpu: root.cpu-load; mem: root.mem-load; }
        if root.keyboard-layout-visible: LayoutSwitcher {
            layout: root.keyboard-layout;
            clicked => { root.cycle-keyboard-layout(); }
        }
        if root.battery-present: BatteryApplet {
            percent: root.battery-percent;
            charging: root.battery-charging;
            horizontal: true;
        }
        if root.tray-icons.length > 0: Rectangle { width: 1px; background: Theme.surface; }
        TrayStrip {
            items: root.tray-icons;
            horizontal: true;
            activate(id) => { root.tray-activate(id); }
        }
        Rectangle { width: 1px; background: Theme.surface; }
        WorkspaceSwitcher {
            active: root.active-workspace;
            count: root.workspace-count;
            thickness: root.thickness;
            horizontal: true;
            switch(n) => { root.switch-workspace(n); }
        }
        Rectangle { width: 1px; background: Theme.surface; }
        HorizontalLayout {
            horizontal-stretch: 1;
            spacing: 6px;
            alignment: start;
            for win in root.windows: TaskItem {
                tile: win;
                width: 110px;
                activate => { root.activate(win.id); }
            }
        }
        PanelButton {
            icon: "🖥";
            width: 36px;
            tooltip: "Show desktop";
            edge: root.edge;
            clicked => { root.show-desktop(); }
        }
    }
}
