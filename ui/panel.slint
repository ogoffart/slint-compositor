import { Theme } from "theme.slint";
import { Clock } from "clock.slint";
import { Eyes } from "eyes.slint";
import { WindowTile } from "types.slint";

// A single icon button in the panel.
component PanelButton inherits Rectangle {
    in property <string> icon;
    in property <color> icon-color: Theme.fg;
    callback clicked();
    border-radius: 8px;
    background: ta.has-hover ? Theme.surface : Theme.panel;
    Text {
        text: root.icon;
        color: root.icon-color;
        font-size: 18px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    ta := TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

// A taskbar entry for one window.
component TaskItem inherits Rectangle {
    in property <WindowTile> tile;
    callback activate();
    border-radius: 6px;
    background: tile.focused ? Theme.accent : (a.has-hover ? Theme.surface : Theme.panel);
    Text {
        text: tile.title == "" ? "?" : tile.title;
        color: Theme.fg;
        font-size: 11px;
        horizontal-alignment: center;
        vertical-alignment: center;
        overflow: elide;
        width: parent.width - 8px;
    }
    a := TouchArea {
        clicked => {
            root.activate();
        }
    }
}

// Virtual-desktop switcher: a strip of numbered buttons.
component WorkspaceSwitcher {
    in property <int> active;
    in property <bool> horizontal;
    callback switch(int);
    property <[int]> indices: [0, 1, 2, 3];

    if root.horizontal: HorizontalLayout {
        spacing: 4px;
        for i in root.indices: Rectangle {
            width: 28px;
            height: 28px;
            border-radius: 6px;
            background: i == root.active ? Theme.accent : Theme.surface;
            Text {
                text: "\{i + 1}";
                color: Theme.fg;
                font-size: 12px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            TouchArea { clicked => { root.switch(i); } }
        }
    }
    if !root.horizontal: VerticalLayout {
        spacing: 4px;
        for i in root.indices: Rectangle {
            height: 26px;
            border-radius: 6px;
            background: i == root.active ? Theme.accent : Theme.surface;
            Text {
                text: "\{i + 1}";
                color: Theme.fg;
                font-size: 12px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            TouchArea { clicked => { root.switch(i); } }
        }
    }
}

// The shell panel. Lays its content out along its long axis: vertically when
// docked left/right, horizontally when docked top/bottom.
export component Panel inherits Rectangle {
    in property <bool> horizontal;
    in property <[WindowTile]> windows;
    in property <string> clock-hours;
    in property <string> clock-minutes;
    in property <length> cursor-x;
    in property <length> cursor-y;
    in property <int> active-workspace;
    in property <int> workspace-count: 4;
    callback toggle-launcher();
    callback toggle-settings();
    callback activate(int);
    callback switch-workspace(int);

    background: Theme.panel;

    if !root.horizontal: VerticalLayout {
        padding: 8px;
        spacing: 10px;
        PanelButton {
            icon: "▶";
            icon-color: Theme.accent;
            height: 40px;
            clicked => { root.toggle-launcher(); }
        }
        PanelButton {
            icon: "⚙";
            icon-color: #f9e2af;
            height: 40px;
            clicked => { root.toggle-settings(); }
        }
        Clock { hours: root.clock-hours; minutes: root.clock-minutes; }
        Eyes { cursor-x: root.cursor-x; cursor-y: root.cursor-y; }
        Rectangle { height: 1px; background: Theme.surface; }
        WorkspaceSwitcher {
            active: root.active-workspace;
            horizontal: false;
            switch(n) => { root.switch-workspace(n); }
        }
        Rectangle { height: 1px; background: Theme.surface; }
        VerticalLayout {
            vertical-stretch: 1;
            spacing: 6px;
            alignment: start;
            for win in root.windows: TaskItem {
                tile: win;
                height: 40px;
                activate => { root.activate(win.id); }
            }
        }
        Text { text: "•••"; color: Theme.subtext; horizontal-alignment: center; }
    }

    if root.horizontal: HorizontalLayout {
        padding: 8px;
        spacing: 10px;
        PanelButton {
            icon: "▶";
            icon-color: Theme.accent;
            width: 40px;
            clicked => { root.toggle-launcher(); }
        }
        PanelButton {
            icon: "⚙";
            icon-color: #f9e2af;
            width: 40px;
            clicked => { root.toggle-settings(); }
        }
        Clock { hours: root.clock-hours; minutes: root.clock-minutes; }
        Eyes { cursor-x: root.cursor-x; cursor-y: root.cursor-y; }
        Rectangle { width: 1px; background: Theme.surface; }
        WorkspaceSwitcher {
            active: root.active-workspace;
            horizontal: true;
            switch(n) => { root.switch-workspace(n); }
        }
        Rectangle { width: 1px; background: Theme.surface; }
        HorizontalLayout {
            horizontal-stretch: 1;
            spacing: 6px;
            alignment: start;
            for win in root.windows: TaskItem {
                tile: win;
                width: 110px;
                activate => { root.activate(win.id); }
            }
        }
        Text { text: "•••"; color: Theme.subtext; vertical-alignment: center; }
    }
}
