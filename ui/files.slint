import { Theme } from "theme.slint";
import { FileItem } from "types.slint";
import { FileIcon } from "file_icon.slint";
import { Button, ScrollView, LineEdit } from "std-widgets.slint";

// One segment of the view-mode switch.
component SegBtn inherits Rectangle {
    in property <string> label;
    in property <bool> active;
    callback clicked;
    width: 34px;
    height: 30px;
    background: active ? Theme.accent : (ta.has-hover ? Theme.hover : Theme.surface);
    border-radius: 7px;
    animate background { duration: 100ms; }
    Text {
        text: root.label;
        color: root.active ? #ffffff : Theme.fg;
        font-size: 15px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    ta := TouchArea {
        clicked => { root.clicked(); }
    }
}

// Standalone file-browser window. Runs as its own Wayland client (its own
// binary), but shares the look of the in-shell file dialog: the same type
// icons, image previews and keyboard model. Three view modes: large icons, a
// list with a preview pane, and a details table. All logic — listing,
// navigation, launching — lives in Rust; this is purely the view.
export component Files inherits Window {
    in property <string> window-title: "Files";
    title: root.window-title;
    preferred-width: 980px;
    preferred-height: 640px;
    min-width: 520px;
    min-height: 360px;
    background: Theme.bg;

    in property <string> path;
    in property <[FileItem]> items;
    in-out property <int> selected: -1;
    // Preview of the selected image (empty for non-images), plus its name and a
    // short, human-readable description of the selection (size / kind).
    in property <image> preview;
    in property <string> selected-name;
    in property <string> selected-info;
    in property <bool> can-back;
    // 0 = icons, 1 = list + preview, 2 = details table.
    in-out property <int> view: 0;

    callback go-back();
    callback go-up();
    callback go-home();
    callback navigate-to(string);     // a path typed into the editable bar
    callback entry-clicked(int);      // single click: select + preview
    callback activate(int);           // double-click / Enter: open dir or launch
    callback move-selection(int);     // keyboard delta (big = home/end)
    callback activate-selected();     // Enter on the current selection

    property <length> row-h: 30px;
    property <length> tile-w: 136px;
    property <length> tile-h: 124px;
    // Columns and centring offset for the icon grid.
    property <int> columns: max(1, floor(scroll.visible-width / root.tile-w));
    property <length> grid-pad: max(0px, (scroll.visible-width - root.columns * root.tile-w) / 2);

    init => {
        keys.focus();
    }

    // Keep the selected entry scrolled into view (works across all three views).
    changed selected => {
        if (root.selected >= 0) {
            if (root.view == 0) {
                // Icon grid: rows are tile-high, addressed by row index.
                if (floor(root.selected / root.columns) * root.tile-h < -scroll.viewport-y) {
                    scroll.viewport-y = -(floor(root.selected / root.columns) * root.tile-h);
                } else if ((floor(root.selected / root.columns) + 1) * root.tile-h > -scroll.viewport-y + scroll.visible-height) {
                    scroll.viewport-y = -((floor(root.selected / root.columns) + 1) * root.tile-h - scroll.visible-height);
                }
            } else {
                if (root.selected * root.row-h < -scroll.viewport-y) {
                    scroll.viewport-y = -(root.selected * root.row-h);
                } else if ((root.selected + 1) * root.row-h > -scroll.viewport-y + scroll.visible-height) {
                    scroll.viewport-y = -((root.selected + 1) * root.row-h - scroll.visible-height);
                }
            }
        }
    }

    VerticalLayout {
        padding: 10px;
        spacing: 10px;

        // Toolbar: navigation, editable path, view switch.
        HorizontalLayout {
            spacing: 6px;
            Button {
                text: "←";
                enabled: root.can-back;
                clicked => { root.go-back(); keys.focus(); }
            }
            Button {
                text: "⬆";
                clicked => { root.go-up(); keys.focus(); }
            }
            Button {
                text: "⌂";
                clicked => { root.go-home(); keys.focus(); }
            }
            Rectangle {
                horizontal-stretch: 1;
                background: Theme.surface;
                border-radius: 6px;
                border-width: 1px;
                border-color: Theme.hover;
                HorizontalLayout {
                    padding: 2px;
                    path-edit := LineEdit {
                        text: root.path;
                        placeholder-text: "Type a path…";
                        accepted(text) => {
                            root.navigate-to(text);
                            keys.focus();
                        }
                    }
                }
            }
            // View switch.
            Rectangle {
                background: Theme.surface;
                border-radius: 8px;
                HorizontalLayout {
                    padding: 2px;
                    spacing: 2px;
                    SegBtn {
                        label: "▦";
                        active: root.view == 0;
                        clicked => { root.view = 0; keys.focus(); }
                    }
                    SegBtn {
                        label: "☰";
                        active: root.view == 1;
                        clicked => { root.view = 1; keys.focus(); }
                    }
                    SegBtn {
                        label: "≣";
                        active: root.view == 2;
                        clicked => { root.view = 2; keys.focus(); }
                    }
                }
            }
        }

        keys := FocusScope {
            key-pressed(e) => {
                // In the icon grid, up/down move by a full row of columns.
                if (e.text == Key.UpArrow) {
                    root.move-selection(root.view == 0 ? -root.columns : -1);
                    return EventResult.accept;
                }
                if (e.text == Key.DownArrow) {
                    root.move-selection(root.view == 0 ? root.columns : 1);
                    return EventResult.accept;
                }
                if (e.text == Key.LeftArrow) {
                    if (root.view == 0) {
                        root.move-selection(-1);
                    } else {
                        root.go-up();
                    }
                    return EventResult.accept;
                }
                if (e.text == Key.RightArrow) {
                    if (root.view == 0) {
                        root.move-selection(1);
                    } else {
                        root.activate-selected();
                    }
                    return EventResult.accept;
                }
                if (e.text == Key.PageUp) {
                    root.move-selection(root.view == 0 ? -root.columns * 3 : -12);
                    return EventResult.accept;
                }
                if (e.text == Key.PageDown) {
                    root.move-selection(root.view == 0 ? root.columns * 3 : 12);
                    return EventResult.accept;
                }
                if (e.text == Key.Home) {
                    root.move-selection(-100000);
                    return EventResult.accept;
                }
                if (e.text == Key.End) {
                    root.move-selection(100000);
                    return EventResult.accept;
                }
                if (e.text == Key.Return) {
                    root.activate-selected();
                    return EventResult.accept;
                }
                if (e.text == Key.Backspace) {
                    root.go-back();
                    return EventResult.accept;
                }
                return EventResult.reject;
            }

            HorizontalLayout {
                spacing: 10px;

                // Main area: optional details header + the scrolling view.
                Rectangle {
                    horizontal-stretch: root.view == 1 ? 3 : 1;
                    background: Theme.surface;
                    border-radius: 8px;
                    clip: true;
                    VerticalLayout {
                        // Details-view column header.
                        if root.view == 2: Rectangle {
                            height: 28px;
                            background: Theme.bg;
                            HorizontalLayout {
                                padding-left: 12px;
                                padding-right: 12px;
                                spacing: 10px;
                                Text {
                                    text: "Name";
                                    color: Theme.subtext;
                                    font-size: 11px;
                                    font-weight: 600;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                }
                                Text {
                                    text: "Size";
                                    color: Theme.subtext;
                                    font-size: 11px;
                                    font-weight: 600;
                                    vertical-alignment: center;
                                    horizontal-alignment: right;
                                    width: 90px;
                                }
                                Text {
                                    text: "Modified";
                                    color: Theme.subtext;
                                    font-size: 11px;
                                    font-weight: 600;
                                    vertical-alignment: center;
                                    width: 150px;
                                }
                                Text {
                                    text: "Type";
                                    color: Theme.subtext;
                                    font-size: 11px;
                                    font-weight: 600;
                                    vertical-alignment: center;
                                    width: 70px;
                                }
                            }
                        }

                        scroll := ScrollView {
                            // --- Icon grid -------------------------------------
                            if root.view == 0: Rectangle {
                                width: scroll.visible-width;
                                height: max(scroll.visible-height, ceil(root.items.length / root.columns) * root.tile-h);
                                for item[idx] in root.items: Rectangle {
                                    x: root.grid-pad + Math.mod(idx, root.columns) * root.tile-w;
                                    y: floor(idx / root.columns) * root.tile-h;
                                    width: root.tile-w;
                                    height: root.tile-h;
                                    tile := Rectangle {
                                        width: parent.width - 8px;
                                        height: parent.height - 8px;
                                        background: idx == root.selected ? Theme.accent
                                            : (tarea.has-hover ? Theme.hover : transparent);
                                        border-radius: 10px;
                                        VerticalLayout {
                                            padding: 10px;
                                            spacing: 6px;
                                            // Icon / thumbnail area.
                                            Rectangle {
                                                height: 72px;
                                                if item.thumb.width > 0: Image {
                                                    source: item.thumb;
                                                    image-fit: contain;
                                                    width: 100%;
                                                    height: 100%;
                                                }
                                                if item.thumb.width == 0: FileIcon {
                                                    width: 60px;
                                                    height: 60px;
                                                    kind: item.kind;
                                                    is-dir: item.is-dir;
                                                }
                                            }
                                            Text {
                                                text: item.name;
                                                color: idx == root.selected ? #ffffff : Theme.fg;
                                                font-size: 12px;
                                                font-weight: item.is-dir ? 600 : 400;
                                                horizontal-alignment: center;
                                                wrap: word-wrap;
                                                overflow: elide;
                                                max-height: 32px;
                                            }
                                        }
                                    }
                                    tarea := TouchArea {
                                        clicked => { root.entry-clicked(idx); }
                                        double-clicked => {
                                            root.entry-clicked(idx);
                                            root.activate(idx);
                                        }
                                    }
                                }
                            }

                            // --- List (compact rows) ---------------------------
                            if root.view == 1: VerticalLayout {
                                alignment: start;
                                for item[idx] in root.items: Rectangle {
                                    height: root.row-h;
                                    background: idx == root.selected ? Theme.accent
                                        : (larea.has-hover ? Theme.hover : transparent);
                                    border-radius: 6px;
                                    HorizontalLayout {
                                        padding-left: 8px;
                                        padding-right: 8px;
                                        spacing: 8px;
                                        VerticalLayout {
                                            alignment: center;
                                            FileIcon {
                                                kind: item.kind;
                                                is-dir: item.is-dir;
                                            }
                                        }
                                        Text {
                                            text: item.name;
                                            color: idx == root.selected ? #ffffff
                                                : (item.is-dir ? Theme.fg : Theme.fg.darker(0.1));
                                            font-size: 13px;
                                            font-weight: item.is-dir ? 600 : 400;
                                            vertical-alignment: center;
                                            overflow: elide;
                                            horizontal-stretch: 1;
                                        }
                                        if item.is-dir: Text {
                                            text: "›";
                                            color: idx == root.selected ? #ffffff : Theme.hover;
                                            font-size: 16px;
                                            vertical-alignment: center;
                                        }
                                    }
                                    larea := TouchArea {
                                        clicked => { root.entry-clicked(idx); }
                                        double-clicked => {
                                            root.entry-clicked(idx);
                                            root.activate(idx);
                                        }
                                    }
                                }
                            }

                            // --- Details table ---------------------------------
                            if root.view == 2: VerticalLayout {
                                alignment: start;
                                for item[idx] in root.items: Rectangle {
                                    height: root.row-h;
                                    background: idx == root.selected ? Theme.accent
                                        : (darea.has-hover ? Theme.hover : transparent);
                                    HorizontalLayout {
                                        padding-left: 12px;
                                        padding-right: 12px;
                                        spacing: 10px;
                                        HorizontalLayout {
                                            horizontal-stretch: 1;
                                            spacing: 8px;
                                            VerticalLayout {
                                                alignment: center;
                                                FileIcon {
                                                    width: 18px;
                                                    height: 18px;
                                                    kind: item.kind;
                                                    is-dir: item.is-dir;
                                                }
                                            }
                                            Text {
                                                text: item.name;
                                                color: idx == root.selected ? #ffffff
                                                    : (item.is-dir ? Theme.fg : Theme.fg.darker(0.1));
                                                font-size: 13px;
                                                font-weight: item.is-dir ? 600 : 400;
                                                vertical-alignment: center;
                                                overflow: elide;
                                                horizontal-stretch: 1;
                                            }
                                        }
                                        Text {
                                            text: item.size;
                                            color: idx == root.selected ? #ffffff : Theme.subtext;
                                            font-size: 12px;
                                            vertical-alignment: center;
                                            horizontal-alignment: right;
                                            width: 90px;
                                        }
                                        Text {
                                            text: item.modified;
                                            color: idx == root.selected ? #ffffff : Theme.subtext;
                                            font-size: 12px;
                                            vertical-alignment: center;
                                            width: 150px;
                                        }
                                        Text {
                                            text: item.kind == "dir" ? "Folder" : item.kind;
                                            color: idx == root.selected ? #ffffff : Theme.subtext;
                                            font-size: 12px;
                                            vertical-alignment: center;
                                            width: 70px;
                                        }
                                    }
                                    darea := TouchArea {
                                        clicked => { root.entry-clicked(idx); }
                                        double-clicked => {
                                            root.entry-clicked(idx);
                                            root.activate(idx);
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                // Preview pane (list view only).
                if root.view == 1: Rectangle {
                    horizontal-stretch: 2;
                    background: Theme.surface;
                    border-radius: 8px;
                    VerticalLayout {
                        padding: 12px;
                        spacing: 10px;
                        Rectangle {
                            vertical-stretch: 1;
                            if root.preview.width > 0: Image {
                                source: root.preview;
                                image-fit: contain;
                                width: parent.width;
                                height: parent.height;
                            }
                            if root.preview.width == 0: VerticalLayout {
                                alignment: center;
                                HorizontalLayout {
                                    alignment: center;
                                    Text {
                                        text: root.selected-name == "" ? "No selection" : "No preview";
                                        color: Theme.hover;
                                        font-size: 14px;
                                    }
                                }
                            }
                        }
                        Text {
                            text: root.selected-name;
                            color: Theme.fg;
                            font-size: 13px;
                            horizontal-alignment: center;
                            overflow: elide;
                        }
                        Text {
                            text: root.selected-info;
                            color: Theme.subtext;
                            font-size: 11px;
                            horizontal-alignment: center;
                            overflow: elide;
                        }
                    }
                }
            }
        }

        // Status bar.
        Text {
            text: root.items.length == 1 ? "1 item" : root.items.length + " items";
            color: Theme.subtext;
            font-size: 11px;
        }
    }
}
