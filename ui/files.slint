import { Theme } from "theme.slint";
import { FileItem, Place, Crumb } from "types.slint";
import { FileIcon } from "file_icon.slint";
import { Button, ScrollView, LineEdit } from "std-widgets.slint";

// One segment of the view-mode switch.
component SegBtn inherits Rectangle {
    in property <string> label;
    in property <bool> active;
    callback clicked;
    width: 34px;
    height: 30px;
    background: active ? Theme.accent : (ta.has-hover ? Theme.hover : Theme.surface);
    border-radius: 7px;
    animate background { duration: 100ms; }
    Text {
        text: root.label;
        color: root.active ? #ffffff : Theme.fg;
        font-size: 15px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    ta := TouchArea {
        clicked => { root.clicked(); }
    }
}

// A single context-menu entry.
component MenuRow inherits Rectangle {
    in property <string> label;
    in property <bool> enabled: true;
    callback chosen;
    height: 30px;
    background: ta.has-hover && root.enabled ? Theme.hover : transparent;
    border-radius: 5px;
    Text {
        text: root.label;
        x: 12px;
        width: parent.width - 24px;
        vertical-alignment: center;
        color: root.enabled ? Theme.fg : Theme.subtext;
        font-size: 13px;
    }
    ta := TouchArea {
        enabled: root.enabled;
        clicked => { root.chosen(); }
    }
}

// A clickable Places-sidebar shortcut.
component PlaceRow inherits Rectangle {
    in property <string> label;
    in property <bool> active;
    callback chosen;
    height: 32px;
    background: root.active ? Theme.accent : (ta.has-hover ? Theme.hover : transparent);
    border-radius: 6px;
    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 8px;
        VerticalLayout {
            alignment: center;
            FileIcon { width: 18px; height: 18px; is-dir: true; }
        }
        Text {
            text: root.label;
            color: root.active ? #ffffff : Theme.fg;
            font-size: 13px;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }
    }
    ta := TouchArea {
        clicked => { root.chosen(); }
    }
}

// A clickable breadcrumb path segment.
component BreadcrumbBtn inherits Rectangle {
    in property <string> label;
    callback clicked;
    background: ta.has-hover ? Theme.hover : transparent;
    border-radius: 4px;
    HorizontalLayout {
        padding-left: 6px;
        padding-right: 6px;
        Text {
            text: root.label;
            color: Theme.fg;
            font-size: 13px;
            vertical-alignment: center;
        }
    }
    ta := TouchArea {
        clicked => { root.clicked(); }
    }
}

// A clickable details-view column header showing the active sort arrow.
component HeaderCell inherits Rectangle {
    in property <string> label;
    in property <int> sort-col;
    in property <int> active-key;
    in property <bool> desc;
    in property <bool> align-right;
    callback clicked;
    Text {
        text: root.label + (root.active-key == root.sort-col ? (root.desc ? " ▼" : " ▲") : "");
        color: root.active-key == root.sort-col ? Theme.fg : Theme.subtext;
        font-size: 11px;
        font-weight: 600;
        vertical-alignment: center;
        horizontal-alignment: root.align-right ? right : left;
        width: 100%;
    }
    ta := TouchArea {
        clicked => { root.clicked(); }
    }
}

// Mouse interaction for one row/tile: left press selects (honouring Ctrl/Shift),
// right press opens the context menu, double-click activates.
component RowHit inherits TouchArea {
    in property <int> index;
    in property <bool> is-selected;
    callback press(int, bool, bool);
    callback context(int, length, length, bool);
    callback open(int);
    pointer-event(e) => {
        if (e.kind == PointerEventKind.down) {
            if (e.button == PointerEventButton.left) {
                root.press(root.index, e.modifiers.control, e.modifiers.shift);
            } else if (e.button == PointerEventButton.right) {
                root.context(root.index,
                    self.absolute-position.x + self.mouse-x,
                    self.absolute-position.y + self.mouse-y,
                    root.is-selected);
            }
        }
    }
    double-clicked => { root.open(root.index); }
}

// Standalone file-browser window. Runs as its own Wayland client, sharing the
// look of the in-shell file dialog. Three view modes (icons / list / details),
// multi-selection, a context menu and file operations (copy/cut/paste, rename,
// trash, new folder). All filesystem logic lives in Rust; this is the view.
export component Files inherits Window {
    in property <string> window-title: "Files";
    title: root.window-title;
    preferred-width: 980px;
    preferred-height: 640px;
    min-width: 520px;
    min-height: 360px;
    background: Theme.bg;

    in property <string> path;
    in property <[FileItem]> items;
    in-out property <int> cursor: -1;
    in property <int> selection-count;
    in property <bool> can-paste;
    in property <image> preview;
    in property <string> selected-name;
    in property <string> selected-info;
    in property <bool> can-back;
    // 0 = icons, 1 = list + preview, 2 = details table.
    in-out property <int> view: 0;
    // Sort column (0 name, 1 size, 2 modified, 3 type) + direction, and dotfiles.
    in property <int> sort-key;
    in property <bool> sort-desc;
    in property <bool> show-hidden;
    in property <[Place]> places;
    in property <[Crumb]> crumbs;
    in-out property <string> search-text;
    in property <bool> is-empty;
    in property <bool> unreadable;
    in property <string> selection-size;
    // When true, the breadcrumb is replaced by an editable path field.
    property <bool> editing-path;

    callback go-back();
    callback go-up();
    callback go-home();
    callback go-to(string);
    callback sort-by(int);
    callback toggle-hidden();
    callback search(string);
    callback type-ahead(string);
    callback navigate-to(string);
    callback row-pressed(int, bool, bool);  // idx, ctrl, shift
    callback move-cursor(int, bool);        // delta, shift (extend)
    callback select-all();
    callback activate(int);                 // open dir / launch file
    callback activate-selected();
    callback copy();
    callback cut();
    callback paste();
    callback trash();
    callback rename(string);
    callback new-folder(string);

    property <length> row-h: 30px;
    property <length> tile-w: 136px;
    property <length> tile-h: 124px;
    property <int> columns: max(1, floor(scroll.visible-width / root.tile-w));
    property <length> grid-pad: max(0px, (scroll.visible-width - root.columns * root.tile-w) / 2);

    // Context-menu anchor (window coordinates).
    property <length> menu-x;
    property <length> menu-y;

    // Rename / new-folder prompt state.
    property <bool> prompt-visible;
    property <string> prompt-title;
    property <int> prompt-mode;       // 1 = rename, 2 = new folder
    property <string> prompt-initial;

    init => {
        keys.focus();
    }

    // Open the rename/new-folder prompt.
    function open-rename() {
        if (root.selection-count >= 1) {
            root.prompt-mode = 1;
            root.prompt-title = "Rename";
            root.prompt-initial = root.selected-name;
            root.prompt-visible = true;
        }
    }
    function open-new-folder() {
        root.prompt-mode = 2;
        root.prompt-title = "New Folder";
        root.prompt-initial = "untitled folder";
        root.prompt-visible = true;
    }

    // Keep the cursor entry scrolled into view (works across all three views).
    changed cursor => {
        if (root.cursor >= 0) {
            if (root.view == 0) {
                if (floor(root.cursor / root.columns) * root.tile-h < -scroll.viewport-y) {
                    scroll.viewport-y = -(floor(root.cursor / root.columns) * root.tile-h);
                } else if ((floor(root.cursor / root.columns) + 1) * root.tile-h > -scroll.viewport-y + scroll.visible-height) {
                    scroll.viewport-y = -((floor(root.cursor / root.columns) + 1) * root.tile-h - scroll.visible-height);
                }
            } else {
                if (root.cursor * root.row-h < -scroll.viewport-y) {
                    scroll.viewport-y = -(root.cursor * root.row-h);
                } else if ((root.cursor + 1) * root.row-h > -scroll.viewport-y + scroll.visible-height) {
                    scroll.viewport-y = -((root.cursor + 1) * root.row-h - scroll.visible-height);
                }
            }
        }
    }

    VerticalLayout {
        padding: 10px;
        spacing: 10px;

        // Toolbar: navigation, editable path, new folder, view switch.
        HorizontalLayout {
            spacing: 6px;
            Button {
                text: "←";
                enabled: root.can-back;
                clicked => { root.go-back(); keys.focus(); }
            }
            Button {
                text: "⬆";
                clicked => { root.go-up(); keys.focus(); }
            }
            Button {
                text: "⌂";
                clicked => { root.go-home(); keys.focus(); }
            }
            // Path area: clickable breadcrumb, or an editable field.
            Rectangle {
                horizontal-stretch: 1;
                background: Theme.surface;
                border-radius: 6px;
                border-width: 1px;
                border-color: Theme.hover;
                clip: true;
                if !root.editing-path: HorizontalLayout {
                    padding-left: 4px;
                    padding-right: 4px;
                    alignment: start;
                    for crumb[i] in root.crumbs: HorizontalLayout {
                        VerticalLayout {
                            alignment: center;
                            if i > 0: Text {
                                text: "›";
                                color: Theme.subtext;
                                font-size: 13px;
                                width: 14px;
                                horizontal-alignment: center;
                            }
                        }
                        BreadcrumbBtn {
                            label: crumb.name;
                            clicked => { root.go-to(crumb.path); keys.focus(); }
                        }
                    }
                }
                if root.editing-path: HorizontalLayout {
                    padding: 2px;
                    path-edit := LineEdit {
                        text: root.path;
                        placeholder-text: "Type a path…";
                        init => { self.focus(); self.select-all(); }
                        accepted(text) => {
                            root.navigate-to(text);
                            root.editing-path = false;
                            keys.focus();
                        }
                    }
                }
            }
            Button {
                text: root.editing-path ? "✓" : "✎";
                clicked => {
                    root.editing-path = !root.editing-path;
                    if (!root.editing-path) { keys.focus(); }
                }
            }
            Rectangle {
                width: 158px;
                background: Theme.surface;
                border-radius: 6px;
                border-width: 1px;
                border-color: Theme.hover;
                HorizontalLayout {
                    padding: 2px;
                    search := LineEdit {
                        placeholder-text: "Search";
                        text <=> root.search-text;
                        edited(t) => { root.search(t); }
                    }
                }
            }
            Button {
                text: "New Folder";
                clicked => { root.open-new-folder(); }
            }
            Button {
                text: root.show-hidden ? "Hidden ✓" : "Hidden";
                clicked => { root.toggle-hidden(); keys.focus(); }
            }
            Rectangle {
                background: Theme.surface;
                border-radius: 8px;
                HorizontalLayout {
                    padding: 2px;
                    spacing: 2px;
                    SegBtn {
                        label: "▦";
                        active: root.view == 0;
                        clicked => { root.view = 0; keys.focus(); }
                    }
                    SegBtn {
                        label: "☰";
                        active: root.view == 1;
                        clicked => { root.view = 1; keys.focus(); }
                    }
                    SegBtn {
                        label: "≣";
                        active: root.view == 2;
                        clicked => { root.view = 2; keys.focus(); }
                    }
                }
            }
        }

        keys := FocusScope {
            vertical-stretch: 1;
            key-pressed(e) => {
                // Operation shortcuts.
                if (e.modifiers.control && (e.text == "c" || e.text == "C")) {
                    root.copy();
                    return EventResult.accept;
                }
                if (e.modifiers.control && (e.text == "x" || e.text == "X")) {
                    root.cut();
                    return EventResult.accept;
                }
                if (e.modifiers.control && (e.text == "v" || e.text == "V")) {
                    root.paste();
                    return EventResult.accept;
                }
                if (e.modifiers.control && (e.text == "a" || e.text == "A")) {
                    root.select-all();
                    return EventResult.accept;
                }
                if (e.modifiers.control && (e.text == "h" || e.text == "H")) {
                    root.toggle-hidden();
                    return EventResult.accept;
                }
                if (e.modifiers.control && (e.text == "f" || e.text == "F")) {
                    search.focus();
                    return EventResult.accept;
                }
                if (e.text == Key.Escape) {
                    root.search-text = "";
                    root.search("");
                    root.editing-path = false;
                    return EventResult.accept;
                }
                if (e.text == Key.Delete) {
                    root.trash();
                    return EventResult.accept;
                }
                if (e.text == Key.F2) {
                    root.open-rename();
                    return EventResult.accept;
                }
                // Movement (Shift extends the selection).
                if (e.text == Key.UpArrow) {
                    root.move-cursor(root.view == 0 ? -root.columns : -1, e.modifiers.shift);
                    return EventResult.accept;
                }
                if (e.text == Key.DownArrow) {
                    root.move-cursor(root.view == 0 ? root.columns : 1, e.modifiers.shift);
                    return EventResult.accept;
                }
                if (e.text == Key.LeftArrow) {
                    if (root.view == 0) {
                        root.move-cursor(-1, e.modifiers.shift);
                    } else {
                        root.go-up();
                    }
                    return EventResult.accept;
                }
                if (e.text == Key.RightArrow) {
                    if (root.view == 0) {
                        root.move-cursor(1, e.modifiers.shift);
                    } else {
                        root.activate-selected();
                    }
                    return EventResult.accept;
                }
                if (e.text == Key.PageUp) {
                    root.move-cursor(root.view == 0 ? -root.columns * 3 : -12, e.modifiers.shift);
                    return EventResult.accept;
                }
                if (e.text == Key.PageDown) {
                    root.move-cursor(root.view == 0 ? root.columns * 3 : 12, e.modifiers.shift);
                    return EventResult.accept;
                }
                if (e.text == Key.Home) {
                    root.move-cursor(-100000, e.modifiers.shift);
                    return EventResult.accept;
                }
                if (e.text == Key.End) {
                    root.move-cursor(100000, e.modifiers.shift);
                    return EventResult.accept;
                }
                if (e.text == Key.Return) {
                    root.activate-selected();
                    return EventResult.accept;
                }
                if (e.text == Key.Backspace) {
                    root.go-back();
                    return EventResult.accept;
                }
                // Type-ahead: a plain printable key jumps to the next match.
                if (!e.modifiers.control && !e.modifiers.alt && e.text != "") {
                    root.type-ahead(e.text);
                    return EventResult.accept;
                }
                return EventResult.reject;
            }

            HorizontalLayout {
                spacing: 10px;

                // Places sidebar.
                Rectangle {
                    width: 168px;
                    background: Theme.surface;
                    border-radius: 8px;
                    clip: true;
                    VerticalLayout {
                        padding: 8px;
                        spacing: 2px;
                        alignment: start;
                        Text {
                            text: "Places";
                            color: Theme.subtext;
                            font-size: 11px;
                            font-weight: 600;
                            height: 22px;
                            vertical-alignment: center;
                        }
                        for place[i] in root.places: PlaceRow {
                            label: place.name;
                            active: place.path == root.path;
                            chosen => { root.go-to(place.path); keys.focus(); }
                        }
                    }
                }

                Rectangle {
                    horizontal-stretch: root.view == 1 ? 3 : 1;
                    background: Theme.surface;
                    border-radius: 8px;
                    clip: true;
                    VerticalLayout {
                        if root.view == 2: Rectangle {
                            height: 28px;
                            background: Theme.bg;
                            HorizontalLayout {
                                padding-left: 12px;
                                padding-right: 12px;
                                spacing: 10px;
                                HeaderCell {
                                    label: "Name";
                                    sort-col: 0;
                                    active-key: root.sort-key;
                                    desc: root.sort-desc;
                                    horizontal-stretch: 1;
                                    clicked => { root.sort-by(0); }
                                }
                                HeaderCell {
                                    label: "Size";
                                    sort-col: 1;
                                    active-key: root.sort-key;
                                    desc: root.sort-desc;
                                    align-right: true;
                                    width: 90px;
                                    clicked => { root.sort-by(1); }
                                }
                                HeaderCell {
                                    label: "Modified";
                                    sort-col: 2;
                                    active-key: root.sort-key;
                                    desc: root.sort-desc;
                                    width: 150px;
                                    clicked => { root.sort-by(2); }
                                }
                                HeaderCell {
                                    label: "Type";
                                    sort-col: 3;
                                    active-key: root.sort-key;
                                    desc: root.sort-desc;
                                    width: 70px;
                                    clicked => { root.sort-by(3); }
                                }
                            }
                        }

                        scroll := ScrollView {
                            // --- Icon grid -------------------------------------
                            if root.view == 0: Rectangle {
                                width: scroll.visible-width;
                                height: max(scroll.visible-height, ceil(root.items.length / root.columns) * root.tile-h);
                                for item[idx] in root.items: Rectangle {
                                    x: root.grid-pad + Math.mod(idx, root.columns) * root.tile-w;
                                    y: floor(idx / root.columns) * root.tile-h;
                                    width: root.tile-w;
                                    height: root.tile-h;
                                    Rectangle {
                                        width: parent.width - 8px;
                                        height: parent.height - 8px;
                                        background: item.selected ? Theme.accent
                                            : (ihit.has-hover ? Theme.hover : transparent);
                                        border-radius: 10px;
                                        border-width: idx == root.cursor ? 2px : 0;
                                        border-color: Theme.accent.brighter(0.4);
                                        VerticalLayout {
                                            padding: 10px;
                                            spacing: 6px;
                                            Rectangle {
                                                height: 72px;
                                                if item.thumb.width > 0: Image {
                                                    source: item.thumb;
                                                    image-fit: contain;
                                                    width: 100%;
                                                    height: 100%;
                                                }
                                                if item.thumb.width == 0: FileIcon {
                                                    width: 60px;
                                                    height: 60px;
                                                    kind: item.kind;
                                                    is-dir: item.is-dir;
                                                }
                                            }
                                            Text {
                                                text: item.name;
                                                color: item.selected ? #ffffff : Theme.fg;
                                                font-size: 12px;
                                                font-weight: item.is-dir ? 600 : 400;
                                                horizontal-alignment: center;
                                                wrap: word-wrap;
                                                overflow: elide;
                                                max-height: 32px;
                                            }
                                        }
                                    }
                                    ihit := RowHit {
                                        index: idx;
                                        is-selected: item.selected;
                                        press(i, c, s) => { root.row-pressed(i, c, s); }
                                        open(i) => { root.activate(i); }
                                        context(i, mx, my, sel) => {
                                            if (!sel) { root.row-pressed(i, false, false); }
                                            root.menu-x = mx;
                                            root.menu-y = my;
                                            ctx.show();
                                        }
                                    }
                                }
                            }

                            // --- List (compact rows) ---------------------------
                            if root.view == 1: VerticalLayout {
                                alignment: start;
                                for item[idx] in root.items: Rectangle {
                                    height: root.row-h;
                                    background: item.selected ? Theme.accent
                                        : (lhit.has-hover ? Theme.hover : transparent);
                                    border-radius: 6px;
                                    border-width: idx == root.cursor && !item.selected ? 1px : 0;
                                    border-color: Theme.accent.brighter(0.4);
                                    HorizontalLayout {
                                        padding-left: 8px;
                                        padding-right: 8px;
                                        spacing: 8px;
                                        VerticalLayout {
                                            alignment: center;
                                            FileIcon {
                                                kind: item.kind;
                                                is-dir: item.is-dir;
                                            }
                                        }
                                        Text {
                                            text: item.name;
                                            color: item.selected ? #ffffff
                                                : (item.is-dir ? Theme.fg : Theme.fg.darker(0.1));
                                            font-size: 13px;
                                            font-weight: item.is-dir ? 600 : 400;
                                            vertical-alignment: center;
                                            overflow: elide;
                                            horizontal-stretch: 1;
                                        }
                                        if item.is-dir: Text {
                                            text: "›";
                                            color: item.selected ? #ffffff : Theme.hover;
                                            font-size: 16px;
                                            vertical-alignment: center;
                                        }
                                    }
                                    lhit := RowHit {
                                        index: idx;
                                        is-selected: item.selected;
                                        press(i, c, s) => { root.row-pressed(i, c, s); }
                                        open(i) => { root.activate(i); }
                                        context(i, mx, my, sel) => {
                                            if (!sel) { root.row-pressed(i, false, false); }
                                            root.menu-x = mx;
                                            root.menu-y = my;
                                            ctx.show();
                                        }
                                    }
                                }
                            }

                            // --- Details table ---------------------------------
                            if root.view == 2: VerticalLayout {
                                alignment: start;
                                for item[idx] in root.items: Rectangle {
                                    height: root.row-h;
                                    background: item.selected ? Theme.accent
                                        : (dhit.has-hover ? Theme.hover : transparent);
                                    border-width: idx == root.cursor && !item.selected ? 1px : 0;
                                    border-color: Theme.accent.brighter(0.4);
                                    HorizontalLayout {
                                        padding-left: 12px;
                                        padding-right: 12px;
                                        spacing: 10px;
                                        HorizontalLayout {
                                            horizontal-stretch: 1;
                                            spacing: 8px;
                                            VerticalLayout {
                                                alignment: center;
                                                FileIcon {
                                                    width: 18px;
                                                    height: 18px;
                                                    kind: item.kind;
                                                    is-dir: item.is-dir;
                                                }
                                            }
                                            Text {
                                                text: item.name;
                                                color: item.selected ? #ffffff
                                                    : (item.is-dir ? Theme.fg : Theme.fg.darker(0.1));
                                                font-size: 13px;
                                                font-weight: item.is-dir ? 600 : 400;
                                                vertical-alignment: center;
                                                overflow: elide;
                                                horizontal-stretch: 1;
                                            }
                                        }
                                        Text {
                                            text: item.size;
                                            color: item.selected ? #ffffff : Theme.subtext;
                                            font-size: 12px;
                                            vertical-alignment: center;
                                            horizontal-alignment: right;
                                            width: 90px;
                                        }
                                        Text {
                                            text: item.modified;
                                            color: item.selected ? #ffffff : Theme.subtext;
                                            font-size: 12px;
                                            vertical-alignment: center;
                                            width: 150px;
                                        }
                                        Text {
                                            text: item.kind == "dir" ? "Folder" : item.kind;
                                            color: item.selected ? #ffffff : Theme.subtext;
                                            font-size: 12px;
                                            vertical-alignment: center;
                                            width: 70px;
                                        }
                                    }
                                    dhit := RowHit {
                                        index: idx;
                                        is-selected: item.selected;
                                        press(i, c, s) => { root.row-pressed(i, c, s); }
                                        open(i) => { root.activate(i); }
                                        context(i, mx, my, sel) => {
                                            if (!sel) { root.row-pressed(i, false, false); }
                                            root.menu-x = mx;
                                            root.menu-y = my;
                                            ctx.show();
                                        }
                                    }
                                }
                            }
                        }
                    }
                    // Empty / unreadable folder message.
                    if root.is-empty: Rectangle {
                        VerticalLayout {
                            alignment: center;
                            HorizontalLayout {
                                alignment: center;
                                Text {
                                    text: root.unreadable ? "Can't read this folder"
                                        : (root.search-text != "" ? "No matches" : "This folder is empty");
                                    color: Theme.subtext;
                                    font-size: 14px;
                                }
                            }
                        }
                    }
                }

                // Preview pane (list view only).
                if root.view == 1: Rectangle {
                    horizontal-stretch: 2;
                    background: Theme.surface;
                    border-radius: 8px;
                    VerticalLayout {
                        padding: 12px;
                        spacing: 10px;
                        Rectangle {
                            vertical-stretch: 1;
                            if root.preview.width > 0: Image {
                                source: root.preview;
                                image-fit: contain;
                                width: parent.width;
                                height: parent.height;
                            }
                            if root.preview.width == 0: VerticalLayout {
                                alignment: center;
                                HorizontalLayout {
                                    alignment: center;
                                    Text {
                                        text: root.selected-name == "" ? "No selection" : "No preview";
                                        color: Theme.hover;
                                        font-size: 14px;
                                    }
                                }
                            }
                        }
                        Text {
                            text: root.selected-name;
                            color: Theme.fg;
                            font-size: 13px;
                            horizontal-alignment: center;
                            overflow: elide;
                        }
                        Text {
                            text: root.selected-info;
                            color: Theme.subtext;
                            font-size: 11px;
                            horizontal-alignment: center;
                            overflow: elide;
                        }
                    }
                }
            }
        }

        // Status bar.
        Text {
            text: (root.items.length == 1 ? "1 item" : root.items.length + " items")
                + (root.selection-count > 0 ? " · " + root.selection-count + " selected" : "")
                + (root.selection-size != "" ? " (" + root.selection-size + ")" : "");
            color: Theme.subtext;
            font-size: 11px;
        }
    }

    // Context menu.
    ctx := PopupWindow {
        x: root.menu-x;
        y: root.menu-y;
        width: 200px;
        Rectangle {
            background: Theme.panel;
            border-radius: 8px;
            border-width: 1px;
            border-color: Theme.hover;
            drop-shadow-blur: 16px;
            drop-shadow-color: #00000088;
            VerticalLayout {
                padding: 6px;
                spacing: 1px;
                MenuRow {
                    label: "Open";
                    enabled: root.selection-count >= 1;
                    chosen => { ctx.close(); root.activate-selected(); }
                }
                MenuRow {
                    label: "Rename";
                    enabled: root.selection-count == 1;
                    chosen => { ctx.close(); root.open-rename(); }
                }
                Rectangle { height: 7px; Rectangle { height: 1px; background: Theme.hover; } }
                MenuRow {
                    label: "Cut";
                    enabled: root.selection-count >= 1;
                    chosen => { ctx.close(); root.cut(); }
                }
                MenuRow {
                    label: "Copy";
                    enabled: root.selection-count >= 1;
                    chosen => { ctx.close(); root.copy(); }
                }
                MenuRow {
                    label: "Paste";
                    enabled: root.can-paste;
                    chosen => { ctx.close(); root.paste(); }
                }
                Rectangle { height: 7px; Rectangle { height: 1px; background: Theme.hover; } }
                MenuRow {
                    label: "New Folder";
                    chosen => { ctx.close(); root.open-new-folder(); }
                }
                MenuRow {
                    label: "Move to Trash";
                    enabled: root.selection-count >= 1;
                    chosen => { ctx.close(); root.trash(); }
                }
            }
        }
    }

    // Rename / new-folder modal prompt.
    if root.prompt-visible: Rectangle {
        background: Theme.overlay;
        TouchArea {
            clicked => { root.prompt-visible = false; keys.focus(); }
        }
        Rectangle {
            width: 380px;
            height: 160px;
            background: Theme.bg;
            border-radius: 12px;
            border-width: 1px;
            border-color: Theme.hover;
            drop-shadow-blur: 24px;
            drop-shadow-color: #00000099;
            TouchArea {}  // swallow clicks on the panel
            VerticalLayout {
                padding: 18px;
                spacing: 14px;
                Text {
                    text: root.prompt-title;
                    color: Theme.fg;
                    font-size: 16px;
                    font-weight: 600;
                }
                pe := LineEdit {
                    text: root.prompt-initial;
                    accepted(t) => {
                        if (root.prompt-mode == 1) { root.rename(t); }
                        else { root.new-folder(t); }
                        root.prompt-visible = false;
                        keys.focus();
                    }
                }
                HorizontalLayout {
                    alignment: end;
                    spacing: 8px;
                    Button {
                        text: "Cancel";
                        clicked => { root.prompt-visible = false; keys.focus(); }
                    }
                    Button {
                        text: "OK";
                        primary: true;
                        clicked => {
                            if (root.prompt-mode == 1) { root.rename(pe.text); }
                            else { root.new-folder(pe.text); }
                            root.prompt-visible = false;
                            keys.focus();
                        }
                    }
                }
            }
            init => {
                pe.focus();
                pe.select-all();
            }
        }
    }
}
