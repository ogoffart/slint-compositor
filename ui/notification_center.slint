import { Theme } from "theme.slint";
import { Button, ScrollView } from "std-widgets.slint";
import { Notification } from "types.slint";

// The notification history + Do-Not-Disturb toggle, shown as a top-right flyout.
export component NotificationCenter inherits Rectangle {
    in property <[Notification]> notes;
    in property <bool> dnd;
    callback clear();
    callback toggle-dnd();
    callback dismiss();

    background: Theme.overlay;
    TouchArea {
        clicked => {
            root.dismiss();
        }
    }

    Rectangle {
        x: parent.width - self.width - 12px;
        y: 12px;
        width: 360px;
        height: min(540px, parent.height - 24px);
        background: Theme.bg;
        border-radius: 12px;
        border-width: 1px;
        border-color: Theme.hover;

        TouchArea {}

        VerticalLayout {
            padding: 14px;
            spacing: 8px;

            HorizontalLayout {
                spacing: 8px;
                Text {
                    text: "Notifications";
                    color: Theme.fg;
                    font-size: 14px;
                    font-weight: 700;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
                Button {
                    text: root.dnd ? "🔕 On" : "🔔 Off";
                    clicked => {
                        root.toggle-dnd();
                    }
                }
                Button {
                    text: "Clear";
                    clicked => {
                        root.clear();
                    }
                }
            }

            if root.notes.length == 0: Text {
                text: "No notifications";
                color: Theme.subtext;
                font-size: 13px;
                horizontal-alignment: center;
                vertical-alignment: center;
                vertical-stretch: 1;
            }

            if root.notes.length > 0: ScrollView {
                vertical-stretch: 1;
                VerticalLayout {
                    spacing: 6px;
                    for n in root.notes: Rectangle {
                        height: row.preferred-height;
                        border-radius: 8px;
                        background: Theme.surface;
                        row := HorizontalLayout {
                            padding: 8px;
                            spacing: 8px;
                            if n.icon.width > 0: Image {
                                source: n.icon;
                                width: 28px;
                                height: 28px;
                                image-fit: contain;
                                vertical-alignment: top;
                            }
                            VerticalLayout {
                                spacing: 2px;
                                horizontal-stretch: 1;
                                Text {
                                    text: n.summary != "" ? n.summary : n.app-name;
                                    color: Theme.fg;
                                    font-size: 13px;
                                    font-weight: 700;
                                    overflow: elide;
                                }
                                if n.body != "": Text {
                                    text: n.body;
                                    color: Theme.subtext;
                                    font-size: 12px;
                                    wrap: word-wrap;
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
