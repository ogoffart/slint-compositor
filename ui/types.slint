// A popup (menu/dropdown/tooltip), positioned at an absolute screen location.
export struct PopupTile {
    id: int,
    texture: image,
    x: length,
    y: length,
    width: length,
    height: length,
}

// An entry in the file dialog's current directory.
export struct FileItem {
    name: string,
    is-dir: bool,
}

// A composited client window: its current frame, title, geometry and state.
export struct WindowTile {
    id: int,
    texture: image,
    title: string,
    decorated: bool,
    focused: bool,
    minimized: bool,
    maximized: bool,
    x: length,
    y: length,
    width: length,
    height: length,
}
