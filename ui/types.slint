// A popup (menu/dropdown/tooltip), positioned at an absolute screen location.
export struct PopupTile {
    id: int,
    texture: image,
    x: length,
    y: length,
    width: length,
    height: length,
}

// A layer-shell surface (wallpaper/bar/notification). `layer`: 0=background,
// 1=bottom, 2=top, 3=overlay.
export struct LayerTile {
    id: int,
    texture: image,
    layer: int,
    x: length,
    y: length,
    width: length,
    height: length,
}

// An entry in the file dialog's current directory. `kind` is a coarse type used
// to pick an icon: "dir", "image", "audio", "video", "archive", "code", "text",
// "pdf", "exec" or "file". `size`/`modified` are pre-formatted for the details
// view; `thumb` is a small image preview for image files (empty otherwise).
export struct FileItem {
    name: string,
    is-dir: bool,
    kind: string,
    size: string,
    modified: string,
    thumb: image,
    // Whether this row is part of the current multi-selection.
    selected: bool,
}

// A start-menu application entry. `kind`: "app" launches `command`, "run" opens
// the run dialog, "lock" locks the screen, "logout" quits the compositor.
export struct MenuEntry {
    name: string,
    command: string,
    icon: string,
    kind: string,
}

// A StatusNotifierItem (SNI) tray icon.
export struct TrayIcon {
    id: string,
    title: string,
    icon: image,
}

// An on-screen notification popup.
export struct Notification {
    id: int,
    app-name: string,
    summary: string,
    body: string,
    icon: image,
}

// A WiFi access point shown in the quick-settings network list.
export struct WifiNetwork {
    ssid: string,
    strength: int,   // 0..100
    secure: bool,
    active: bool,
}

// A composited client window: its current frame, title, geometry and state.
export struct WindowTile {
    id: int,
    texture: image,
    icon: image,
    title: string,
    decorated: bool,
    focused: bool,
    minimized: bool,
    maximized: bool,
    workspace: int,
    x: length,
    y: length,
    width: length,
    height: length,
}
