import { Theme } from "theme.slint";
import { Panel } from "panel.slint";
import { Launcher } from "launcher.slint";
import { StartMenu } from "start_menu.slint";
import { LockScreen } from "lock_screen.slint";
import { QuickSettings } from "quick_settings.slint";
import { Notifications } from "notifications.slint";
import { NotificationCenter } from "notification_center.slint";
import { CalendarPopover } from "calendar.slint";
import { DesktopMenu } from "desktop_menu.slint";
import { WindowMenu } from "window_menu.slint";
import { WindowSwitcher } from "window_switcher.slint";
import { Osd } from "osd.slint";
import { Settings } from "settings.slint";
import { FileDialog } from "file_dialog.slint";
import { WindowTile, FileItem, PopupTile, LayerTile, MenuEntry, TrayIcon, WifiNetwork, Notification, CalendarDay, OutputRect } from "types.slint";
export { WindowTile, FileItem, PopupTile, LayerTile, MenuEntry, TrayIcon, WifiNetwork, Notification, CalendarDay, OutputRect }
export { Theme }

// Server-side decoration + input routing for one client window.
component WindowFrame inherits Rectangle {
    in property <WindowTile> tile;
    callback close();
    callback minimize();
    callback toggle-maximize();
    callback moved(length, length);              // title-bar drag delta
    callback dragging(length, length);           // cursor pos during a drag
    callback dropped(length, length);            // cursor pos when a drag ends
    callback menu-requested(length, length);     // right-click on the title bar
    callback resized(length, length);            // resize-grip drag delta
    callback focus-requested();                  // raise + focus
    in property <bool> on-active-workspace: true;

    // Stay rendered while any open/minimize/close animation plays out, but never
    // when the window lives on another (inactive) virtual desktop.
    visible: on-active-workspace && root.factor > 0.005;
    // pointer: surface-local x, y, kind (0=move,1=down,2=up), button (0..3)
    callback pointer(float, float, int, int);
    // cursor-moved: pointer position in window coordinates (for the eyes applet)
    callback cursor-moved(length, length);
    callback scroll(float, float);
    // key: text, pressed, ctrl, alt, shift, meta
    callback key(string, bool, bool, bool, bool, bool);

    // Open / minimize / close are all expressed as a 0..1 factor; the window
    // scales towards its centre and fades. They compose into `factor`.
    property <float> anim: tile.minimized ? 0.0 : 1.0;
    animate anim { duration: 180ms; easing: ease-in-out; }
    property <float> appear: tile.appearing ? 0.0 : 1.0;
    animate appear { duration: 150ms; easing: ease-out; }
    property <float> closef: tile.closing ? 0.0 : 1.0;
    animate closef { duration: 160ms; easing: ease-in; }
    property <float> factor: root.anim * root.appear * root.closef;
    property <length> full-width: tile.width;
    property <length> full-height: tile.decorated ? tile.height + 28px : tile.height;

    clip: true;
    opacity: root.factor;
    width: root.full-width * root.factor;
    height: root.full-height * root.factor;
    x: tile.x + (root.full-width - root.width) / 2;
    y: tile.y + (root.full-height - root.height) / 2;
    // No rounded corners / shadow when maximized (they look wrong flush to the edge).
    border-radius: tile.decorated && !tile.maximized ? 8px : 0px;
    border-width: tile.decorated ? 1px : 0px;
    border-color: tile.focused ? Theme.accent : Theme.hover;
    background: Theme.surface;
    drop-shadow-blur: tile.decorated && !tile.maximized ? 18px : 0px;
    drop-shadow-color: #00000099;
    drop-shadow-offset-y: 5px;

    VerticalLayout {
        // Title bar (server-side decoration only).
        if tile.decorated: Rectangle {
            height: 28px;
            background: tile.focused ? Theme.hover : Theme.surface;

            // Drag the title bar to move the window. Sits beneath the buttons so
            // their TouchAreas (declared after) receive their own clicks.
            drag := TouchArea {
                width: 100%;
                height: 100%;
                mouse-cursor: move;
                moved => {
                    root.moved(self.mouse-x - self.pressed-x, self.mouse-y - self.pressed-y);
                    root.dragging(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                }
                pointer-event(e) => {
                    // On release, report the cursor position so the shell can
                    // snap the window if it was dropped against a screen edge.
                    if e.kind == PointerEventKind.up {
                        root.dropped(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                    } else if e.kind == PointerEventKind.down && e.button == PointerEventButton.right {
                        root.menu-requested(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                    }
                }
                double-clicked => {
                    root.toggle-maximize();
                }
            }

            HorizontalLayout {
                padding-left: 8px;
                padding-right: 4px;
                spacing: 6px;

                Image {
                    source: tile.icon;
                    width: 18px;
                    height: 18px;
                    image-fit: contain;
                }
                Text {
                    text: tile.title == "" ? "(untitled)" : tile.title;
                    color: Theme.fg;
                    font-size: 13px;
                    vertical-alignment: center;
                    overflow: elide;
                    horizontal-stretch: 1;
                }

                Rectangle {
                    width: 22px;
                    y: 3px;
                    height: 22px;
                    border-radius: 4px;
                    background: min-ta.has-hover ? Theme.hover : transparent;
                    Text {
                        text: "—";
                        color: Theme.fg;
                        font-size: 12px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    min-ta := TouchArea {
                        clicked => {
                            root.minimize();
                        }
                    }
                }
                Rectangle {
                    width: 22px;
                    y: 3px;
                    height: 22px;
                    border-radius: 4px;
                    background: max-ta.has-hover ? Theme.hover : transparent;
                    Text {
                        text: tile.maximized ? "▣" : "□";
                        color: Theme.fg;
                        font-size: 12px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    max-ta := TouchArea {
                        clicked => {
                            root.toggle-maximize();
                        }
                    }
                }
                Rectangle {
                    width: 22px;
                    y: 3px;
                    height: 22px;
                    border-radius: 4px;
                    background: close-ta.has-hover ? #f38ba8 : transparent;
                    Text {
                        text: "✕";
                        color: close-ta.has-hover ? #11111b : Theme.fg;
                        font-size: 13px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    close-ta := TouchArea {
                        clicked => {
                            root.close();
                        }
                    }
                }
            }
        }

        // Client content + input.
        fs := FocusScope {
            key-pressed(e) => {
                root.key(e.text, true, e.modifiers.control, e.modifiers.alt, e.modifiers.shift, e.modifiers.meta);
                accept
            }
            key-released(e) => {
                root.key(e.text, false, e.modifiers.control, e.modifiers.alt, e.modifiers.shift, e.modifiers.meta);
                accept
            }

            Image {
                source: tile.texture;
                width: 100%;
                height: 100%;
                image-fit: fill;
                image-rendering: pixelated;
            }

            ta := TouchArea {
                width: 100%;
                height: 100%;
                pointer-event(e) => {
                    if e.kind == PointerEventKind.down {
                        root.focus-requested();
                        fs.focus();
                        root.pointer(ta.mouse-x / 1px, ta.mouse-y / 1px, 1, self.btn-code(e.button));
                    } else if e.kind == PointerEventKind.up {
                        root.pointer(ta.mouse-x / 1px, ta.mouse-y / 1px, 2, self.btn-code(e.button));
                    } else if e.kind == PointerEventKind.move {
                        root.pointer(ta.mouse-x / 1px, ta.mouse-y / 1px, 0, 0);
                        root.cursor-moved(ta.absolute-position.x + ta.mouse-x, ta.absolute-position.y + ta.mouse-y);
                    }
                }
                moved => {
                    root.pointer(ta.mouse-x / 1px, ta.mouse-y / 1px, 0, 0);
                    root.cursor-moved(ta.absolute-position.x + ta.mouse-x, ta.absolute-position.y + ta.mouse-y);
                }
                scroll-event(e) => {
                    root.scroll(e.delta-x / 1px, e.delta-y / 1px);
                    accept
                }
                // Map Slint's button enum to an index (1=left,2=right,3=middle).
                pure function btn-code(b: PointerEventButton) -> int {
                    b == PointerEventButton.left ? 1
                        : b == PointerEventButton.right ? 2
                        : b == PointerEventButton.middle ? 3
                        : 0
                }
            }
        }
    }

    // Resize grip (bottom-right corner).
    Rectangle {
        width: 16px;
        height: 16px;
        x: parent.width - self.width;
        y: parent.height - self.height;
        background: grip.has-hover ? Theme.accent : transparent;
        grip := TouchArea {
            mouse-cursor: nwse-resize;
            moved => {
                root.resized(self.mouse-x - self.pressed-x, self.mouse-y - self.pressed-y);
            }
        }
    }
}

// A clickable shortcut icon on the desktop wallpaper.
component DesktopShortcut inherits Rectangle {
    in property <string> icon;
    in property <string> label;
    callback launch();
    width: 96px;
    height: 86px;
    border-radius: 10px;
    background: ta.has-hover ? Theme.overlay : #00000022;
    VerticalLayout {
        padding: 8px;
        spacing: 2px;
        Text {
            text: root.icon;
            font-size: 34px;
            height: 46px;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        Text {
            text: root.label;
            color: #ffffff;
            font-size: 12px;
            horizontal-alignment: center;
            overflow: elide;
        }
    }
    ta := TouchArea {
        double-clicked => { root.launch(); }
    }
}

// Root scene: composited client windows + the right-edge panel.
export component Desktop inherits Window {
    in property <string> clock-hours;
    in property <string> clock-minutes;
    in property <[WindowTile]> windows;
    // Latest pointer position in window coordinates, fed to the eyes applet.
    property <length> cursor-x;
    property <length> cursor-y;
    in property <[PopupTile]> popups;
    in property <[LayerTile]> layers;
    in property <image> background-image;
    // Output (monitor) regions; the shell draws a panel + wallpaper per output.
    in property <[OutputRect]> outputs: [{ x: 0, y: 0, width: 1280px, height: 800px }];
    in-out property <int> panel-edge: 0;        // 0=Right 1=Left 2=Top 3=Bottom
    in-out property <length> panel-size: 72px;

    // Work area (screen minus the panel), used for the snap preview.
    property <length> work-x: root.panel-edge == 1 ? root.panel-size : 0;
    property <length> work-y: root.panel-edge == 2 ? root.panel-size : 0;
    property <length> work-w: (root.panel-edge == 0 || root.panel-edge == 1)
        ? root.width - root.panel-size : root.width;
    property <length> work-h: (root.panel-edge == 2 || root.panel-edge == 3)
        ? root.height - root.panel-size : root.height;
    // Drag snap preview zone: 0=none, 1=left, 2=right, 3=maximize.
    in-out property <int> snap-preview: 0;
    in-out property <int> active-workspace: 0;
    in property <int> workspace-count: 4;
    in-out property <bool> launcher-visible: false;
    in property <[MenuEntry]> launcher-results;
    callback launcher-query(string);
    // Desktop right-click menu.
    in-out property <bool> desktop-menu-visible: false;
    in-out property <length> desktop-menu-x;
    in-out property <length> desktop-menu-y;
    in property <string> terminal-command;
    // Window title-bar right-click menu.
    in-out property <bool> window-menu-visible: false;
    in-out property <length> window-menu-x;
    in-out property <length> window-menu-y;
    in-out property <int> window-menu-id;
    in-out property <bool> window-menu-maximized;
    in-out property <bool> settings-visible: false;
    in-out property <bool> start-menu-visible: false;
    in-out property <bool> quick-settings-visible: false;
    // Transient volume on-screen display (shown when changed via the keyboard).
    in-out property <bool> osd-visible: false;
    // Transient Alt-Tab window switcher (pre-filtered list built by the host).
    in-out property <bool> switcher-visible: false;
    in property <[WindowTile]> switcher-windows;

    // System tray + quick settings (volume / Wi-Fi), driven from Rust.
    in property <[TrayIcon]> tray-icons;
    in property <float> volume;
    in property <bool> muted;
    in property <bool> battery-present;
    in property <float> battery-percent;
    in property <bool> battery-charging;
    in property <bool> wifi-enabled;
    in property <[WifiNetwork]> wifi-networks;
    callback set-volume(float);
    callback toggle-mute();
    callback wifi-toggle();
    callback wifi-scan();
    callback wifi-connect(string, string);
    callback tray-activate(string);

    // On-screen notifications + history center.
    in property <[Notification]> notifications;
    in property <[Notification]> notif-history;
    in-out property <bool> notification-center-visible: false;
    in property <bool> dnd;
    callback dismiss-notification(int);
    callback clear-notifications();
    callback toggle-dnd();

    // Calendar popover (toggled from the panel clock).
    in-out property <bool> calendar-visible: false;
    in property <string> calendar-title;
    in property <[CalendarDay]> calendar-days;

    // Start menu + lock screen.
    in property <[MenuEntry]> menu-entries;
    in-out property <bool> locked: false;
    in property <bool> lock-has-password;
    in-out property <bool> lock-wrong: false;
    callback logout();
    callback suspend();
    callback reboot();
    callback shutdown();
    callback unlock(string);

    // File dialog state (driven from Rust).
    in-out property <bool> file-dialog-visible: false;
    in property <string> file-dialog-title;
    in property <string> file-dialog-path;
    in property <[FileItem]> file-dialog-items;
    in-out property <int> file-dialog-selected: -1;
    in property <image> file-dialog-preview;
    in property <string> file-dialog-selected-name;
    // Configurable desktop shortcut icons and panel quick-launch buttons.
    in property <[MenuEntry]> desktop-icons;
    in property <[MenuEntry]> panel-launchers;

    callback launch(string);
    callback close-window(int);
    callback minimize-window(int);
    callback toggle-maximize-window(int);
    callback activate-window(int);                       // taskbar / raise + focus
    callback move-window(int, length, length);
    callback drop-window(int, length, length);   // window dropped at cursor (x,y)
    callback window-move-to-workspace(int, int);  // window id, workspace index
    callback resize-window(int, length, length);
    callback pointer-window(int, float, float, int, int);
    callback scroll-window(int, float, float);
    callback key-window(int, string, bool, bool, bool, bool, bool);
    // Global shortcut keys when no client is focused: text, pressed, ctrl, alt, shift, meta.
    callback key-shortcut(string, bool, bool, bool, bool, bool);
    callback change-background();
    callback fd-entry-clicked(int);
    callback fd-go-up();
    callback fd-accept();
    callback fd-cancel();
    callback fd-navigate-to(string);
    callback fd-move-selection(int);
    callback fd-activate-selected();
    callback settings-changed();
    in-out property <int> settings-tab;     // 0 General, 1 Shortcuts
    // Shortcut editing from the Settings dialog: list (0 menu, 1 desktop,
    // 2 panel), index, field (0 icon, 1 name, 2 command) and value.
    callback shortcut-set(int, int, int, string);
    callback shortcut-add(int);
    callback shortcut-remove(int, int);
    callback dismiss-popups();

    preferred-width: 1280px;
    preferred-height: 800px;
    title: "s-compositor";
    background: Theme.bg;
    forward-focus: shortcut-keys;

    // Catches global shortcut keys whenever no client window holds focus.
    shortcut-keys := FocusScope {
        width: 0px;
        height: 0px;
        key-pressed(e) => {
            root.key-shortcut(e.text, true, e.modifiers.control, e.modifiers.alt, e.modifiers.shift, e.modifiers.meta);
            accept
        }
        key-released(e) => {
            root.key-shortcut(e.text, false, e.modifiers.control, e.modifiers.alt, e.modifiers.shift, e.modifiers.meta);
            accept
        }
    }

    // Default gradient wallpaper (shown when no background image is set; the
    // image below covers it when one is).
    Rectangle {
        width: 100%;
        height: 100%;
        background: @linear-gradient(135deg,
            Theme.accent.mix(Theme.bg, 0.22) 0%,
            Theme.bg 55%,
            Theme.panel 100%);
    }

    // Desktop background image (behind everything), one per output.
    for out in root.outputs: Image {
        x: out.x;
        y: out.y;
        width: out.width;
        height: out.height;
        source: root.background-image;
        image-fit: cover;
    }

    // Track the pointer over the empty desktop (eyes applet) and dismiss popups
    // on click. Sits beneath the windows and panel.
    bg-pointer := TouchArea {
        width: 100%;
        height: 100%;
        clicked => {
            root.dismiss-popups();
        }
        pointer-event(e) => {
            if e.kind == PointerEventKind.move {
                root.cursor-x = self.absolute-position.x + self.mouse-x;
                root.cursor-y = self.absolute-position.y + self.mouse-y;
            } else if e.kind == PointerEventKind.down && e.button == PointerEventButton.right {
                root.desktop-menu-x = self.absolute-position.x + self.mouse-x;
                root.desktop-menu-y = self.absolute-position.y + self.mouse-y;
                root.desktop-menu-visible = true;
            }
        }
        moved => {
            root.cursor-x = self.absolute-position.x + self.mouse-x;
            root.cursor-y = self.absolute-position.y + self.mouse-y;
        }
    }

    // Desktop shortcut icons, in a column near the top-left corner (offset to
    // clear the panel when it is docked left or top). Double-click to launch.
    VerticalLayout {
        x: root.outputs[0].x + (root.panel-edge == 1 ? root.panel-size : 0px) + 14px;
        y: root.outputs[0].y + (root.panel-edge == 2 ? root.panel-size : 0px) + 14px;
        width: 96px;
        spacing: 8px;
        alignment: start;
        for app in root.desktop-icons: DesktopShortcut {
            icon: app.icon;
            label: app.name;
            launch => { root.launch(app.command); }
        }
    }

    // Background/bottom layer-shell surfaces (e.g. wallpapers), below windows.
    for l in root.layers: Image {
        visible: l.layer <= 1;
        x: l.x;
        y: l.y;
        width: l.width;
        height: l.height;
        source: l.texture;
        image-fit: fill;
    }

    // Snap preview: a translucent highlight of where a dragged window will land.
    // Zones: 1=left 2=right 3=max 4=top-left 5=top-right 6=bottom-left 7=bottom-right.
    if root.snap-preview != 0: Rectangle {
        x: (root.snap-preview == 2 || root.snap-preview == 5 || root.snap-preview == 7)
            ? root.work-x + root.work-w / 2 : root.work-x;
        y: (root.snap-preview == 6 || root.snap-preview == 7)
            ? root.work-y + root.work-h / 2 : root.work-y;
        width: root.snap-preview == 3 ? root.work-w : root.work-w / 2;
        height: root.snap-preview >= 4 ? root.work-h / 2 : root.work-h;
        border-radius: 8px;
        border-width: 2px;
        border-color: Theme.accent;
        background: Theme.accent.with-alpha(0.22);
    }

    for win in root.windows: WindowFrame {
        tile: win;
        on-active-workspace: win.workspace == root.active-workspace;
        close => {
            root.close-window(win.id);
        }
        minimize => {
            root.minimize-window(win.id);
        }
        toggle-maximize => {
            root.toggle-maximize-window(win.id);
        }
        moved(dx, dy) => {
            root.move-window(win.id, dx, dy);
        }
        dragging(cx, cy) => {
            root.snap-preview = cx <= 16px
                ? (cy <= root.height * 0.33 ? 4 : cy >= root.height * 0.66 ? 6 : 1)
                : cx >= root.width - 16px
                    ? (cy <= root.height * 0.33 ? 5 : cy >= root.height * 0.66 ? 7 : 2)
                    : cy <= 16px ? 3 : 0;
        }
        dropped(cx, cy) => {
            root.snap-preview = 0;
            root.drop-window(win.id, cx, cy);
        }
        menu-requested(cx, cy) => {
            root.window-menu-id = win.id;
            root.window-menu-maximized = win.maximized;
            root.window-menu-x = cx;
            root.window-menu-y = cy;
            root.window-menu-visible = true;
        }
        resized(dw, dh) => {
            root.resize-window(win.id, dw, dh);
        }
        focus-requested => {
            root.activate-window(win.id);
        }
        pointer(x, y, kind, btn) => {
            root.pointer-window(win.id, x, y, kind, btn);
        }
        cursor-moved(cx, cy) => {
            root.cursor-x = cx;
            root.cursor-y = cy;
        }
        scroll(dx, dy) => {
            root.scroll-window(win.id, dx, dy);
        }
        key(text, pressed, ctrl, alt, shift, meta) => {
            root.key-window(win.id, text, pressed, ctrl, alt, shift, meta);
        }
    }

    // Top/overlay layer-shell surfaces (bars, notifications), above windows.
    for l in root.layers: Rectangle {
        visible: l.layer >= 2;
        x: l.x;
        y: l.y;
        width: l.width;
        height: l.height;
        Image {
            source: l.texture;
            width: 100%;
            height: 100%;
            image-fit: fill;
        }
        lta := TouchArea {
            width: 100%;
            height: 100%;
            pointer-event(e) => {
                if e.kind == PointerEventKind.down {
                    root.pointer-window(l.id, lta.mouse-x / 1px, lta.mouse-y / 1px, 1, 1);
                } else if e.kind == PointerEventKind.up {
                    root.pointer-window(l.id, lta.mouse-x / 1px, lta.mouse-y / 1px, 2, 1);
                } else if e.kind == PointerEventKind.move {
                    root.pointer-window(l.id, lta.mouse-x / 1px, lta.mouse-y / 1px, 0, 0);
                }
            }
            moved => {
                root.pointer-window(l.id, lta.mouse-x / 1px, lta.mouse-y / 1px, 0, 0);
            }
        }
    }

    for out in root.outputs: Panel {
        clock-hours: root.clock-hours;
        clock-minutes: root.clock-minutes;
        cursor-x: root.cursor-x;
        cursor-y: root.cursor-y;
        windows: root.windows;
        active-workspace: root.active-workspace;
        workspace-count: root.workspace-count;
        thickness: root.panel-size;
        tray-icons: root.tray-icons;
        launchers: root.panel-launchers;
        muted: root.muted;
        horizontal: root.panel-edge >= 2;
        edge: root.panel-edge;
        width: root.panel-edge >= 2 ? out.width : root.panel-size;
        height: root.panel-edge >= 2 ? root.panel-size : out.height;
        x: out.x + (root.panel-edge == 0 ? out.width - root.panel-size : 0px);
        y: out.y + (root.panel-edge == 3 ? out.height - root.panel-size : 0px);
        toggle-start-menu => {
            root.start-menu-visible = !root.start-menu-visible;
        }
        toggle-settings => {
            root.settings-visible = !root.settings-visible;
        }
        launch(cmd) => {
            root.launch(cmd);
        }
        dnd: root.dnd;
        toggle-quick-settings => {
            root.quick-settings-visible = !root.quick-settings-visible;
        }
        toggle-notification-center => {
            root.notification-center-visible = !root.notification-center-visible;
        }
        toggle-calendar => {
            root.calendar-visible = !root.calendar-visible;
        }
        activate(id) => {
            root.activate-window(id);
        }
        switch-workspace(n) => {
            root.active-workspace = n;
        }
        tray-activate(id) => {
            root.tray-activate(id);
        }
    }

    // Notification popups (top-right; click-through except the cards).
    Notifications {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        notes: root.notifications;
        dismiss(id) => {
            root.dismiss-notification(id);
        }
    }

    if root.notification-center-visible: NotificationCenter {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        notes: root.notif-history;
        dnd: root.dnd;
        clear => {
            root.clear-notifications();
        }
        toggle-dnd => {
            root.toggle-dnd();
        }
        dismiss => {
            root.notification-center-visible = false;
        }
    }

    if root.switcher-visible: WindowSwitcher {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        windows: root.switcher-windows;
    }

    if root.osd-visible: Osd {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        volume: root.volume;
        muted: root.muted;
    }

    // Popups (menus, dropdowns) on top of windows and the panel.
    for p in root.popups: Rectangle {
        x: p.x;
        y: p.y;
        width: p.width;
        height: p.height;
        Image {
            source: p.texture;
            width: 100%;
            height: 100%;
            image-fit: fill;
            image-rendering: pixelated;
        }
        pta := TouchArea {
            width: 100%;
            height: 100%;
            pointer-event(e) => {
                if e.kind == PointerEventKind.down {
                    root.pointer-window(p.id, pta.mouse-x / 1px, pta.mouse-y / 1px, 1, 1);
                } else if e.kind == PointerEventKind.up {
                    root.pointer-window(p.id, pta.mouse-x / 1px, pta.mouse-y / 1px, 2, 1);
                } else if e.kind == PointerEventKind.move {
                    root.pointer-window(p.id, pta.mouse-x / 1px, pta.mouse-y / 1px, 0, 0);
                }
            }
            moved => {
                root.pointer-window(p.id, pta.mouse-x / 1px, pta.mouse-y / 1px, 0, 0);
            }
        }
    }

    if root.launcher-visible: Launcher {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        results: root.launcher-results;
        query-changed(q) => {
            root.launcher-query(q);
        }
        launch(cmd) => {
            root.launch(cmd);
            root.launcher-visible = false;
        }
        dismiss => {
            root.launcher-visible = false;
        }
    }

    if root.desktop-menu-visible: DesktopMenu {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        menu-x: root.desktop-menu-x;
        menu-y: root.desktop-menu-y;
        open-terminal => {
            root.desktop-menu-visible = false;
            root.launch(root.terminal-command);
        }
        change-wallpaper => {
            root.desktop-menu-visible = false;
            root.change-background();
        }
        open-settings => {
            root.desktop-menu-visible = false;
            root.settings-visible = true;
        }
        dismiss => {
            root.desktop-menu-visible = false;
        }
    }

    if root.window-menu-visible: WindowMenu {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        menu-x: root.window-menu-x;
        menu-y: root.window-menu-y;
        maximized: root.window-menu-maximized;
        workspace-count: root.workspace-count;
        current-workspace: root.active-workspace;
        minimize => {
            root.window-menu-visible = false;
            root.minimize-window(root.window-menu-id);
        }
        toggle-maximize => {
            root.window-menu-visible = false;
            root.toggle-maximize-window(root.window-menu-id);
        }
        close => {
            root.window-menu-visible = false;
            root.close-window(root.window-menu-id);
        }
        move-to-workspace(ws) => {
            root.window-menu-visible = false;
            root.window-move-to-workspace(root.window-menu-id, ws);
        }
        dismiss => {
            root.window-menu-visible = false;
        }
    }

    if root.start-menu-visible: StartMenu {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        entries: root.menu-entries;
        launch(cmd) => {
            root.launch(cmd);
            root.start-menu-visible = false;
        }
        run => {
            root.start-menu-visible = false;
            root.launcher-visible = true;
        }
        lock => {
            root.start-menu-visible = false;
            root.lock-wrong = false;
            root.locked = true;
        }
        suspend => {
            root.start-menu-visible = false;
            root.suspend();
        }
        reboot => {
            root.start-menu-visible = false;
            root.reboot();
        }
        shutdown => {
            root.start-menu-visible = false;
            root.shutdown();
        }
        logout => {
            root.logout();
        }
        dismiss => {
            root.start-menu-visible = false;
        }
    }

    if root.quick-settings-visible: QuickSettings {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        volume: root.volume;
        muted: root.muted;
        battery-present: root.battery-present;
        battery-percent: root.battery-percent;
        battery-charging: root.battery-charging;
        wifi-enabled: root.wifi-enabled;
        networks: root.wifi-networks;
        set-volume(v) => {
            root.set-volume(v);
        }
        toggle-mute => {
            root.toggle-mute();
        }
        toggle-wifi => {
            root.wifi-toggle();
        }
        scan => {
            root.wifi-scan();
        }
        connect(ssid, pw) => {
            root.wifi-connect(ssid, pw);
        }
        dismiss => {
            root.quick-settings-visible = false;
        }
    }

    if root.calendar-visible: CalendarPopover {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        title: root.calendar-title;
        days: root.calendar-days;
        dismiss => {
            root.calendar-visible = false;
        }
    }

    if root.locked: LockScreen {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        clock-hours: root.clock-hours;
        clock-minutes: root.clock-minutes;
        has-password: root.lock-has-password;
        wrong: root.lock-wrong;
        unlock(pw) => {
            root.unlock(pw);
        }
    }

    if root.settings-visible: Settings {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        panel-edge <=> root.panel-edge;
        panel-size <=> root.panel-size;
        tab <=> root.settings-tab;
        menu-entries: root.menu-entries;
        desktop-entries: root.desktop-icons;
        panel-entries: root.panel-launchers;
        shortcut-set(l, i, f, v) => {
            root.shortcut-set(l, i, f, v);
        }
        shortcut-add(l) => {
            root.shortcut-add(l);
        }
        shortcut-remove(l, i) => {
            root.shortcut-remove(l, i);
        }
        change-background => {
            root.settings-visible = false;
            root.change-background();
        }
        changed => {
            root.settings-changed();
        }
        close => {
            root.settings-visible = false;
        }
    }

    if root.file-dialog-visible: FileDialog {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        title: root.file-dialog-title;
        path: root.file-dialog-path;
        items: root.file-dialog-items;
        selected <=> root.file-dialog-selected;
        preview: root.file-dialog-preview;
        selected-name: root.file-dialog-selected-name;
        entry-clicked(i) => {
            root.fd-entry-clicked(i);
        }
        go-up => {
            root.fd-go-up();
        }
        accept => {
            root.fd-accept();
        }
        cancel => {
            root.fd-cancel();
        }
        navigate-to(p) => {
            root.fd-navigate-to(p);
        }
        move-selection(d) => {
            root.fd-move-selection(d);
        }
        activate-selected => {
            root.fd-activate-selected();
        }
    }
}
