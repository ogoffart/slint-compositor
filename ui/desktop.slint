import { Theme } from "theme.slint";
import { Panel } from "panel.slint";
import { Launcher } from "launcher.slint";
import { StartMenu } from "start_menu.slint";
import { LockScreen } from "lock_screen.slint";
import { QuickSettings } from "quick_settings.slint";
import { Notifications } from "notifications.slint";
import { CalendarPopover } from "calendar.slint";
import { Settings } from "settings.slint";
import { FileDialog } from "file_dialog.slint";
import { WindowTile, FileItem, PopupTile, LayerTile, MenuEntry, TrayIcon, WifiNetwork, Notification, CalendarDay } from "types.slint";
export { WindowTile, FileItem, PopupTile, LayerTile, MenuEntry, TrayIcon, WifiNetwork, Notification, CalendarDay }
export { Theme }

// Server-side decoration + input routing for one client window.
component WindowFrame inherits Rectangle {
    in property <WindowTile> tile;
    callback close();
    callback minimize();
    callback toggle-maximize();
    callback moved(length, length);              // title-bar drag delta
    callback resized(length, length);            // resize-grip drag delta
    callback focus-requested();                  // raise + focus
    in property <bool> on-active-workspace: true;

    // Stay rendered while the minimize/restore animation plays out, but never
    // when the window lives on another (inactive) virtual desktop.
    visible: on-active-workspace && (!tile.minimized || root.anim > 0.01);
    // pointer: surface-local x, y, kind (0=move,1=down,2=up), button (0..3)
    callback pointer(float, float, int, int);
    // cursor-moved: pointer position in window coordinates (for the eyes applet)
    callback cursor-moved(length, length);
    callback scroll(float, float);
    // key: text, pressed, ctrl, alt, shift, meta
    callback key(string, bool, bool, bool, bool, bool);

    // Minimize / restore animation: 1.0 = fully shown, 0.0 = minimized away. The
    // window scales down towards its centre and fades out.
    property <float> anim: tile.minimized ? 0.0 : 1.0;
    animate anim { duration: 180ms; easing: ease-in-out; }
    property <length> full-width: tile.width;
    property <length> full-height: tile.decorated ? tile.height + 28px : tile.height;

    clip: true;
    opacity: root.anim;
    width: root.full-width * root.anim;
    height: root.full-height * root.anim;
    x: tile.x + (root.full-width - root.width) / 2;
    y: tile.y + (root.full-height - root.height) / 2;
    border-width: tile.decorated ? 1px : 0px;
    border-color: tile.focused ? Theme.accent : Theme.hover;
    background: Theme.surface;

    VerticalLayout {
        // Title bar (server-side decoration only).
        if tile.decorated: Rectangle {
            height: 28px;
            background: tile.focused ? Theme.hover : Theme.surface;

            // Drag the title bar to move the window. Sits beneath the buttons so
            // their TouchAreas (declared after) receive their own clicks.
            drag := TouchArea {
                width: 100%;
                height: 100%;
                mouse-cursor: move;
                moved => {
                    root.moved(self.mouse-x - self.pressed-x, self.mouse-y - self.pressed-y);
                }
            }

            HorizontalLayout {
                padding-left: 8px;
                padding-right: 4px;
                spacing: 6px;

                Image {
                    source: tile.icon;
                    width: 18px;
                    height: 18px;
                    image-fit: contain;
                }
                Text {
                    text: tile.title == "" ? "(untitled)" : tile.title;
                    color: Theme.fg;
                    font-size: 13px;
                    vertical-alignment: center;
                    overflow: elide;
                    horizontal-stretch: 1;
                }

                Rectangle {
                    width: 22px;
                    y: 3px;
                    height: 22px;
                    border-radius: 4px;
                    background: min-ta.has-hover ? Theme.hover : transparent;
                    Text {
                        text: "—";
                        color: Theme.fg;
                        font-size: 12px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    min-ta := TouchArea {
                        clicked => {
                            root.minimize();
                        }
                    }
                }
                Rectangle {
                    width: 22px;
                    y: 3px;
                    height: 22px;
                    border-radius: 4px;
                    background: max-ta.has-hover ? Theme.hover : transparent;
                    Text {
                        text: tile.maximized ? "▣" : "□";
                        color: Theme.fg;
                        font-size: 12px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    max-ta := TouchArea {
                        clicked => {
                            root.toggle-maximize();
                        }
                    }
                }
                Rectangle {
                    width: 22px;
                    y: 3px;
                    height: 22px;
                    border-radius: 4px;
                    background: close-ta.has-hover ? #f38ba8 : transparent;
                    Text {
                        text: "✕";
                        color: close-ta.has-hover ? #11111b : Theme.fg;
                        font-size: 13px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    close-ta := TouchArea {
                        clicked => {
                            root.close();
                        }
                    }
                }
            }
        }

        // Client content + input.
        fs := FocusScope {
            key-pressed(e) => {
                root.key(e.text, true, e.modifiers.control, e.modifiers.alt, e.modifiers.shift, e.modifiers.meta);
                accept
            }
            key-released(e) => {
                root.key(e.text, false, e.modifiers.control, e.modifiers.alt, e.modifiers.shift, e.modifiers.meta);
                accept
            }

            Image {
                source: tile.texture;
                width: 100%;
                height: 100%;
                image-fit: fill;
                image-rendering: pixelated;
            }

            ta := TouchArea {
                width: 100%;
                height: 100%;
                pointer-event(e) => {
                    if e.kind == PointerEventKind.down {
                        root.focus-requested();
                        fs.focus();
                        root.pointer(ta.mouse-x / 1px, ta.mouse-y / 1px, 1, self.btn-code(e.button));
                    } else if e.kind == PointerEventKind.up {
                        root.pointer(ta.mouse-x / 1px, ta.mouse-y / 1px, 2, self.btn-code(e.button));
                    } else if e.kind == PointerEventKind.move {
                        root.pointer(ta.mouse-x / 1px, ta.mouse-y / 1px, 0, 0);
                        root.cursor-moved(ta.absolute-position.x + ta.mouse-x, ta.absolute-position.y + ta.mouse-y);
                    }
                }
                moved => {
                    root.pointer(ta.mouse-x / 1px, ta.mouse-y / 1px, 0, 0);
                    root.cursor-moved(ta.absolute-position.x + ta.mouse-x, ta.absolute-position.y + ta.mouse-y);
                }
                scroll-event(e) => {
                    root.scroll(e.delta-x / 1px, e.delta-y / 1px);
                    accept
                }
                // Map Slint's button enum to an index (1=left,2=right,3=middle).
                pure function btn-code(b: PointerEventButton) -> int {
                    b == PointerEventButton.left ? 1
                        : b == PointerEventButton.right ? 2
                        : b == PointerEventButton.middle ? 3
                        : 0
                }
            }
        }
    }

    // Resize grip (bottom-right corner).
    Rectangle {
        width: 16px;
        height: 16px;
        x: parent.width - self.width;
        y: parent.height - self.height;
        background: grip.has-hover ? Theme.accent : transparent;
        grip := TouchArea {
            mouse-cursor: nwse-resize;
            moved => {
                root.resized(self.mouse-x - self.pressed-x, self.mouse-y - self.pressed-y);
            }
        }
    }
}

// Root scene: composited client windows + the right-edge panel.
export component Desktop inherits Window {
    in property <string> clock-hours;
    in property <string> clock-minutes;
    in property <[WindowTile]> windows;
    // Latest pointer position in window coordinates, fed to the eyes applet.
    property <length> cursor-x;
    property <length> cursor-y;
    in property <[PopupTile]> popups;
    in property <[LayerTile]> layers;
    in property <image> background-image;
    in-out property <int> panel-edge: 0;        // 0=Right 1=Left 2=Top 3=Bottom
    in-out property <length> panel-size: 72px;
    in-out property <int> active-workspace: 0;
    in property <int> workspace-count: 4;
    in-out property <bool> launcher-visible: false;
    in-out property <bool> settings-visible: false;
    in-out property <bool> start-menu-visible: false;
    in-out property <bool> quick-settings-visible: false;

    // System tray + quick settings (volume / Wi-Fi), driven from Rust.
    in property <[TrayIcon]> tray-icons;
    in property <float> volume;
    in property <bool> muted;
    in property <bool> wifi-enabled;
    in property <[WifiNetwork]> wifi-networks;
    callback set-volume(float);
    callback toggle-mute();
    callback wifi-toggle();
    callback wifi-scan();
    callback wifi-connect(string, string);
    callback tray-activate(string);

    // On-screen notifications.
    in property <[Notification]> notifications;
    callback dismiss-notification(int);

    // Calendar popover (toggled from the panel clock).
    in-out property <bool> calendar-visible: false;
    in property <string> calendar-title;
    in property <[CalendarDay]> calendar-days;

    // Start menu + lock screen.
    in property <[MenuEntry]> menu-entries;
    in-out property <bool> locked: false;
    in property <bool> lock-has-password;
    in-out property <bool> lock-wrong: false;
    callback logout();
    callback suspend();
    callback reboot();
    callback shutdown();
    callback unlock(string);

    // File dialog state (driven from Rust).
    in-out property <bool> file-dialog-visible: false;
    in property <string> file-dialog-title;
    in property <string> file-dialog-path;
    in property <[FileItem]> file-dialog-items;
    in-out property <int> file-dialog-selected: -1;
    in property <image> file-dialog-preview;
    in property <string> file-dialog-selected-name;

    callback launch(string);
    callback close-window(int);
    callback minimize-window(int);
    callback toggle-maximize-window(int);
    callback activate-window(int);                       // taskbar / raise + focus
    callback move-window(int, length, length);
    callback resize-window(int, length, length);
    callback pointer-window(int, float, float, int, int);
    callback scroll-window(int, float, float);
    callback key-window(int, string, bool, bool, bool, bool, bool);
    // Global shortcut keys when no client is focused: text, pressed, ctrl, alt, shift, meta.
    callback key-shortcut(string, bool, bool, bool, bool, bool);
    callback change-background();
    callback fd-entry-clicked(int);
    callback fd-go-up();
    callback fd-accept();
    callback fd-cancel();
    callback fd-navigate-to(string);
    callback fd-move-selection(int);
    callback fd-activate-selected();
    callback settings-changed();
    callback dismiss-popups();

    preferred-width: 1280px;
    preferred-height: 800px;
    title: "s-compositor";
    background: Theme.bg;
    forward-focus: shortcut-keys;

    // Catches global shortcut keys whenever no client window holds focus.
    shortcut-keys := FocusScope {
        width: 0px;
        height: 0px;
        key-pressed(e) => {
            root.key-shortcut(e.text, true, e.modifiers.control, e.modifiers.alt, e.modifiers.shift, e.modifiers.meta);
            accept
        }
        key-released(e) => {
            root.key-shortcut(e.text, false, e.modifiers.control, e.modifiers.alt, e.modifiers.shift, e.modifiers.meta);
            accept
        }
    }

    // Desktop background image (behind everything).
    Image {
        x: 0;
        y: 0;
        width: 100%;
        height: 100%;
        source: root.background-image;
        image-fit: cover;
    }

    // Track the pointer over the empty desktop (eyes applet) and dismiss popups
    // on click. Sits beneath the windows and panel.
    bg-pointer := TouchArea {
        width: 100%;
        height: 100%;
        clicked => {
            root.dismiss-popups();
        }
        pointer-event(e) => {
            if e.kind == PointerEventKind.move {
                root.cursor-x = self.absolute-position.x + self.mouse-x;
                root.cursor-y = self.absolute-position.y + self.mouse-y;
            }
        }
        moved => {
            root.cursor-x = self.absolute-position.x + self.mouse-x;
            root.cursor-y = self.absolute-position.y + self.mouse-y;
        }
    }

    // Background/bottom layer-shell surfaces (e.g. wallpapers), below windows.
    for l in root.layers: Image {
        visible: l.layer <= 1;
        x: l.x;
        y: l.y;
        width: l.width;
        height: l.height;
        source: l.texture;
        image-fit: fill;
    }

    for win in root.windows: WindowFrame {
        tile: win;
        on-active-workspace: win.workspace == root.active-workspace;
        close => {
            root.close-window(win.id);
        }
        minimize => {
            root.minimize-window(win.id);
        }
        toggle-maximize => {
            root.toggle-maximize-window(win.id);
        }
        moved(dx, dy) => {
            root.move-window(win.id, dx, dy);
        }
        resized(dw, dh) => {
            root.resize-window(win.id, dw, dh);
        }
        focus-requested => {
            root.activate-window(win.id);
        }
        pointer(x, y, kind, btn) => {
            root.pointer-window(win.id, x, y, kind, btn);
        }
        cursor-moved(cx, cy) => {
            root.cursor-x = cx;
            root.cursor-y = cy;
        }
        scroll(dx, dy) => {
            root.scroll-window(win.id, dx, dy);
        }
        key(text, pressed, ctrl, alt, shift, meta) => {
            root.key-window(win.id, text, pressed, ctrl, alt, shift, meta);
        }
    }

    // Top/overlay layer-shell surfaces (bars, notifications), above windows.
    for l in root.layers: Rectangle {
        visible: l.layer >= 2;
        x: l.x;
        y: l.y;
        width: l.width;
        height: l.height;
        Image {
            source: l.texture;
            width: 100%;
            height: 100%;
            image-fit: fill;
        }
        lta := TouchArea {
            width: 100%;
            height: 100%;
            pointer-event(e) => {
                if e.kind == PointerEventKind.down {
                    root.pointer-window(l.id, lta.mouse-x / 1px, lta.mouse-y / 1px, 1, 1);
                } else if e.kind == PointerEventKind.up {
                    root.pointer-window(l.id, lta.mouse-x / 1px, lta.mouse-y / 1px, 2, 1);
                } else if e.kind == PointerEventKind.move {
                    root.pointer-window(l.id, lta.mouse-x / 1px, lta.mouse-y / 1px, 0, 0);
                }
            }
            moved => {
                root.pointer-window(l.id, lta.mouse-x / 1px, lta.mouse-y / 1px, 0, 0);
            }
        }
    }

    Panel {
        clock-hours: root.clock-hours;
        clock-minutes: root.clock-minutes;
        cursor-x: root.cursor-x;
        cursor-y: root.cursor-y;
        windows: root.windows;
        active-workspace: root.active-workspace;
        workspace-count: root.workspace-count;
        thickness: root.panel-size;
        tray-icons: root.tray-icons;
        muted: root.muted;
        horizontal: root.panel-edge >= 2;
        width: root.panel-edge >= 2 ? parent.width : root.panel-size;
        height: root.panel-edge >= 2 ? root.panel-size : parent.height;
        x: root.panel-edge == 0 ? parent.width - root.panel-size : 0px;
        y: root.panel-edge == 3 ? parent.height - root.panel-size : 0px;
        toggle-start-menu => {
            root.start-menu-visible = !root.start-menu-visible;
        }
        toggle-settings => {
            root.settings-visible = !root.settings-visible;
        }
        toggle-quick-settings => {
            root.quick-settings-visible = !root.quick-settings-visible;
        }
        toggle-calendar => {
            root.calendar-visible = !root.calendar-visible;
        }
        activate(id) => {
            root.activate-window(id);
        }
        switch-workspace(n) => {
            root.active-workspace = n;
        }
        tray-activate(id) => {
            root.tray-activate(id);
        }
    }

    // Notification popups (top-right; click-through except the cards).
    Notifications {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        notes: root.notifications;
        dismiss(id) => {
            root.dismiss-notification(id);
        }
    }

    // Popups (menus, dropdowns) on top of windows and the panel.
    for p in root.popups: Rectangle {
        x: p.x;
        y: p.y;
        width: p.width;
        height: p.height;
        Image {
            source: p.texture;
            width: 100%;
            height: 100%;
            image-fit: fill;
            image-rendering: pixelated;
        }
        pta := TouchArea {
            width: 100%;
            height: 100%;
            pointer-event(e) => {
                if e.kind == PointerEventKind.down {
                    root.pointer-window(p.id, pta.mouse-x / 1px, pta.mouse-y / 1px, 1, 1);
                } else if e.kind == PointerEventKind.up {
                    root.pointer-window(p.id, pta.mouse-x / 1px, pta.mouse-y / 1px, 2, 1);
                } else if e.kind == PointerEventKind.move {
                    root.pointer-window(p.id, pta.mouse-x / 1px, pta.mouse-y / 1px, 0, 0);
                }
            }
            moved => {
                root.pointer-window(p.id, pta.mouse-x / 1px, pta.mouse-y / 1px, 0, 0);
            }
        }
    }

    if root.launcher-visible: Launcher {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        launch(cmd) => {
            root.launch(cmd);
            root.launcher-visible = false;
        }
        dismiss => {
            root.launcher-visible = false;
        }
    }

    if root.start-menu-visible: StartMenu {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        entries: root.menu-entries;
        launch(cmd) => {
            root.launch(cmd);
            root.start-menu-visible = false;
        }
        run => {
            root.start-menu-visible = false;
            root.launcher-visible = true;
        }
        lock => {
            root.start-menu-visible = false;
            root.lock-wrong = false;
            root.locked = true;
        }
        suspend => {
            root.start-menu-visible = false;
            root.suspend();
        }
        reboot => {
            root.start-menu-visible = false;
            root.reboot();
        }
        shutdown => {
            root.start-menu-visible = false;
            root.shutdown();
        }
        logout => {
            root.logout();
        }
        dismiss => {
            root.start-menu-visible = false;
        }
    }

    if root.quick-settings-visible: QuickSettings {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        volume: root.volume;
        muted: root.muted;
        wifi-enabled: root.wifi-enabled;
        networks: root.wifi-networks;
        set-volume(v) => {
            root.set-volume(v);
        }
        toggle-mute => {
            root.toggle-mute();
        }
        toggle-wifi => {
            root.wifi-toggle();
        }
        scan => {
            root.wifi-scan();
        }
        connect(ssid, pw) => {
            root.wifi-connect(ssid, pw);
        }
        dismiss => {
            root.quick-settings-visible = false;
        }
    }

    if root.calendar-visible: CalendarPopover {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        title: root.calendar-title;
        days: root.calendar-days;
        dismiss => {
            root.calendar-visible = false;
        }
    }

    if root.locked: LockScreen {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        clock-hours: root.clock-hours;
        clock-minutes: root.clock-minutes;
        has-password: root.lock-has-password;
        wrong: root.lock-wrong;
        unlock(pw) => {
            root.unlock(pw);
        }
    }

    if root.settings-visible: Settings {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        panel-edge <=> root.panel-edge;
        panel-size <=> root.panel-size;
        change-background => {
            root.settings-visible = false;
            root.change-background();
        }
        changed => {
            root.settings-changed();
        }
        close => {
            root.settings-visible = false;
        }
    }

    if root.file-dialog-visible: FileDialog {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        title: root.file-dialog-title;
        path: root.file-dialog-path;
        items: root.file-dialog-items;
        selected <=> root.file-dialog-selected;
        preview: root.file-dialog-preview;
        selected-name: root.file-dialog-selected-name;
        entry-clicked(i) => {
            root.fd-entry-clicked(i);
        }
        go-up => {
            root.fd-go-up();
        }
        accept => {
            root.fd-accept();
        }
        cancel => {
            root.fd-cancel();
        }
        navigate-to(p) => {
            root.fd-navigate-to(p);
        }
        move-selection(d) => {
            root.fd-move-selection(d);
        }
        activate-selected => {
            root.fd-activate-selected();
        }
    }
}
