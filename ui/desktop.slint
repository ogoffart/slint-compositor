import { Panel } from "panel.slint";
import { Launcher } from "launcher.slint";

// A composited client window: its current frame plus geometry.
export struct WindowTile {
    id: int,
    texture: image,
    x: length,
    y: length,
    width: length,
    height: length,
}

// Root scene. The area left of the panel is the composited client-window
// layer (Slint `Image`s backed by the clients' committed buffers).
export component Desktop inherits Window {
    in property <string> clock-time;
    in property <[WindowTile]> windows;
    in-out property <bool> launcher-visible: false;

    // Emitted when the user submits a command in the launcher.
    callback launch(string);

    preferred-width: 1280px;
    preferred-height: 800px;
    title: "slick";
    background: #1e1e2e;

    // Client windows, composited under the panel.
    for win in root.windows: Image {
        source: win.texture;
        x: win.x;
        y: win.y;
        width: win.width;
        height: win.height;
        image-fit: fill;
        image-rendering: pixelated;
    }

    Panel {
        clock-time: root.clock-time;
        x: parent.width - self.width;
        y: 0;
        height: parent.height;
        toggle-launcher => {
            root.launcher-visible = !root.launcher-visible;
        }
    }

    if root.launcher-visible: Launcher {
        x: 0;
        y: 0;
        width: parent.width;
        height: parent.height;
        launch(cmd) => {
            root.launch(cmd);
            root.launcher-visible = false;
        }
        dismiss => {
            root.launcher-visible = false;
        }
    }
}
